Ported from: https://github.com/LophineLabs/Lophine/blob/7a51f49a512f1b5465f15a905d3704754e4bed02/lophine-server/minecraft-patches/features/0098-Leaves-Old-Explosion-Damage-Calculator.patch

diff --git a/net/minecraft/world/level/ServerExplosion.java b/net/minecraft/world/level/ServerExplosion.java
index 47c32ad23ac5e28045b958dddd34f95fcc286926..c4711cb0e342d593c9057bdb98e66bce56354fb4 100644
--- a/net/minecraft/world/level/ServerExplosion.java
+++ b/net/minecraft/world/level/ServerExplosion.java
@@ -712,6 +712,7 @@ public class ServerExplosion implements Explosion {
     public boolean shouldAffectBlocklikeEntities() {
         boolean mobGriefingEnabled = this.level.getGameRules().get(GameRules.MOB_GRIEFING);
         boolean isNotWindCharge = this.source == null || !this.source.is(EntityTypes.BREEZE_WIND_CHARGE) && !this.source.is(EntityTypes.WIND_CHARGE);
+        if (fun.bm.mili.config.modules.function.OldFeatureConfig.oldExplosionDamageCalculator || (fun.bm.mili.config.modules.function.OldFeatureConfig.tntWetExplosionNoItemDamage && this.source instanceof net.minecraft.world.entity.item.PrimedTnt)) isNotWindCharge = isNotWindCharge && (this.source == null || !this.source.isInWater()); // Leaves - Old MC TNT wet explosion no item damage
         return mobGriefingEnabled ? isNotWindCharge : this.blockInteraction.shouldAffectBlocklikeEntities() && isNotWindCharge;
     }
 
