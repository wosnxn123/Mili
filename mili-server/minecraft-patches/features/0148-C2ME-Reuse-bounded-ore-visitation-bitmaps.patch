From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taiyou06 <kaandindar21@gmail.com>
Date: Thu, 7 Nov 2024 19:45:31 +0100
Subject: [PATCH] C2ME: Reuse bounded ore visitation bitmaps

Lease a thread-local BitSet until the placement finishes, including on exceptions. Nested placements use independent storage and large bitmaps are discarded. Leave ore placement iteration and random calls unchanged.

Original Leaf port: https://github.com/Winds-Studio/Leaf/blob/06c9c91a17e61aeed16bcfc846ebe91aa70d6c84/leaf-server/minecraft-patches/features/0154-C2ME-Reduce-Allocations.patch
Original project: https://github.com/RelativityMC/C2ME-fabric
Original mixin: com/ishland/c2me/opts/allocs/mixin/object_pooling_caching/MixinOreFeature.java
License: MIT (https://opensource.org/licenses/MIT)

Ported from Lophine (GPLv3 for its changes; see licenses/GPL.md):
https://github.com/LophineLabs/Lophine/blob/7a51f49a512f1b5465f15a905d3704754e4bed02/lophine-server/minecraft-patches/features/0157-C2ME-Reuse-bounded-ore-visitation-bitmaps.patch
Lophine patch blob: cc7dddcb0e1d7763a8cddeeb8478fcd5acc2412e
https://github.com/LophineLabs/Lophine/blob/7a51f49a512f1b5465f15a905d3704754e4bed02/LICENSE.md

Mili port: Keep the original int sizing semantics for uncached placements, but avoid retaining overflowed or oversized requests.

Additional pinned source references:
https://github.com/RelativityMC/C2ME-fabric/blob/8138acfb32daf5d1b264780b6436eb8ff958c1b9/c2me-opts-allocs/src/main/java/com/ishland/c2me/opts/allocs/mixin/object_pooling_caching/MixinOreFeature.java

Series copyright and original license notices: licenses/Lophine-0137-0158-NOTICE.txt

Co-authored-by: ishland <ishlandmc@yeah.net>

diff --git a/net/minecraft/world/level/levelgen/feature/OreFeature.java b/net/minecraft/world/level/levelgen/feature/OreFeature.java
index e6aee6a38f45b47413aa3bbddf3632bc0c6a93f5..b391d8c736b3b47b4630663b7c0d9a47438eeb3d 100644
--- a/net/minecraft/world/level/levelgen/feature/OreFeature.java
+++ b/net/minecraft/world/level/levelgen/feature/OreFeature.java
@@ -17,6 +17,10 @@ import net.minecraft.world.level.levelgen.structure.templatesystem.RuleTest;
 
 public class OreFeature extends AbstractOreFeature {
     public static final MapCodec<OreFeature> CODEC = makeCodec(OreFeature::new);
+    // Leaf start - C2ME - Reduce Allocations
+    private static final int MAX_CACHED_TEST_BITS = 65_536;
+    private static final ThreadLocal<BitSet> TESTED_POSITIONS = new ThreadLocal<>();
+    // Leaf end - C2ME - Reduce Allocations
 
     public OreFeature(final List<BlockReplacement> targetStates, final int size, final float discardChanceOnAirExposure) {
         super(targetStates, size, discardChanceOnAirExposure);
@@ -78,9 +82,45 @@ public class OreFeature extends AbstractOreFeature {
         final int zStart,
         final int sizeXZ,
         final int sizeY
+    ) {
+        // Leaf start - C2ME - Reduce Allocations
+        final int bitCount = sizeXZ * sizeY * sizeXZ;
+        if (sizeXZ < 0 || sizeY < 0 || sizeXZ > MAX_CACHED_TEST_BITS || sizeY > MAX_CACHED_TEST_BITS
+            || (long)sizeXZ * sizeY * sizeXZ > MAX_CACHED_TEST_BITS) {
+            return this.doPlace(level, random, x0, x1, z0, z1, y0, y1, xStart, yStart, zStart, sizeXZ, sizeY, new BitSet(bitCount));
+        }
+
+        final BitSet cached = TESTED_POSITIONS.get();
+        final BitSet tested = cached == null ? new BitSet(bitCount) : cached;
+        TESTED_POSITIONS.set(null);
+        try {
+            return this.doPlace(level, random, x0, x1, z0, z1, y0, y1, xStart, yStart, zStart, sizeXZ, sizeY, tested);
+        } finally {
+            if (tested.size() <= MAX_CACHED_TEST_BITS) {
+                tested.clear();
+                TESTED_POSITIONS.set(tested);
+            }
+        }
+        // Leaf end - C2ME - Reduce Allocations
+    }
+
+    private boolean doPlace(
+        final WorldGenLevel level,
+        final RandomSource random,
+        final double x0,
+        final double x1,
+        final double z0,
+        final double z1,
+        final double y0,
+        final double y1,
+        final int xStart,
+        final int yStart,
+        final int zStart,
+        final int sizeXZ,
+        final int sizeY,
+        final BitSet tested
     ) {
         int placed = 0;
-        BitSet tested = new BitSet(sizeXZ * sizeY * sizeXZ);
         BlockPos.MutableBlockPos orePos = new BlockPos.MutableBlockPos();
         double[] data = new double[this.size * 4];
 
