+                * fun.bm.mili.config.modules.experiment.RayTrackingEntityTrackerConfig.tracingDistance;
+            double hitboxLimit = fun.bm.mili.config.modules.experiment.RayTrackingEntityTrackerConfig.hitboxLimit;
