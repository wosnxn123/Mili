Subject: [PATCH] Carpet: loot, push reactions, and AMS recipes

Adapted from Lophine 7a51f49a512f1b5465f15a905d3704754e4bed02, Minecraft patches 0131-0134.
Retain loot event/capture paths. Register the added recipe set only as RecipeManager is built.
See META-INF/licenses/carpet-26.3.txt for source and license notices.

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index fcf5f97..e6deadc 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -2018,7 +2018,11 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     }
 
     public void dropFromLootTable(final ServerLevel level, final DamageSource source, final boolean playerKilled, final ResourceKey<LootTable> lootTable) {
-        this.dropFromLootTable(level, source, playerKilled, lootTable, itemStack -> this.spawnAtLocation(level, itemStack));
+        this.dropFromLootTable(level, source, playerKilled, lootTable, itemStack -> {
+            if (!fun.bm.mili.carpet.config.modules.GameplayCompatConfig.ironGolemNoDropFlower || !(this instanceof net.minecraft.world.entity.animal.golem.IronGolem) || !itemStack.is(Items.POPPY)) {
+                this.spawnAtLocation(level, itemStack);
+            }
+        });
     }
 
