+        }
+        if (fun.bm.mili.carpet.config.modules.GameplayCompatConfig.rottenFleshBurnedIntoLeather) {
+            addCompatRecipe(recipeMap, new RecipeHolder<>(compatRecipeKey("carpet_leather"), new SmeltingRecipe(new Recipe.CommonInfo(true),
+                new AbstractCookingRecipe.CookingBookInfo(CookingBookCategory.MISC, ""), Ingredient.of(Items.ROTTEN_FLESH),
+                new ItemStackTemplate(Items.LEATHER), 0.1F, 50)));
+        }
+    }
+
+    private static RecipeHolder<?> carpetShaped(final String path, final Item output, final Map<Character, Ingredient> ingredients, final String... pattern) {
+        return new RecipeHolder<>(compatRecipeKey(path), new ShapedRecipe(new Recipe.CommonInfo(true),
+            new CraftingRecipe.CraftingBookInfo(CraftingBookCategory.MISC, ""), ShapedRecipePattern.of(ingredients, pattern), new ItemStackTemplate(output)));
     }
 
