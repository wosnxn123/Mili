diff --git a/net/minecraft/world/level/block/Block.java b/net/minecraft/world/level/block/Block.java
index cd57307..dc62261 100644
--- a/net/minecraft/world/level/block/Block.java
+++ b/net/minecraft/world/level/block/Block.java
@@ -448,6 +448,19 @@ public class Block extends BlockBehaviour implements ItemLike {
     ) {
         if (level instanceof ServerLevel serverLevel) {
             getDrops(state, serverLevel, pos, blockEntity, breaker, tool).forEach(stack -> popResource(level, pos, stack));
+            if (fun.bm.mili.carpet.config.modules.GameplayCompatConfig.cakeBlockDropOnBreak && state.is(Blocks.CAKE) && state.getValue(CakeBlock.BITES) == 0) {
+                popResource(level, pos, new ItemStack(net.minecraft.world.item.Items.CAKE));
+            }
+            int podLimit = fun.bm.mili.carpet.config.modules.GameplayCompatConfig.easyGetPitcherPod();
+            if (podLimit >= 2 && state.is(Blocks.PITCHER_CROP)) {
+                popResource(level, pos, new ItemStack(net.minecraft.world.item.Items.PITCHER_POD, 2 + serverLevel.getRandom().nextInt(podLimit - 1)));
+            }
+            if (fun.bm.mili.carpet.config.modules.GameplayCompatConfig.movableAmethyst && state.is(Blocks.BUDDING_AMETHYST) && breaker instanceof ServerPlayer
+                && tool.is(net.minecraft.tags.ItemTags.PICKAXES) && net.minecraft.world.item.enchantment.EnchantmentHelper.getItemEnchantmentLevel(
+                    serverLevel.registryAccess().lookupOrThrow(net.minecraft.core.registries.Registries.ENCHANTMENT)
+                        .getOrThrow(net.minecraft.world.item.enchantment.Enchantments.SILK_TOUCH), tool) > 0) {
+                popResource(level, pos, new ItemStack(net.minecraft.world.item.Items.BUDDING_AMETHYST));
+            }
             state.spawnAfterBreak(serverLevel, pos, tool, dropExperience); // Paper - Properly handle xp dropping
         }
     }
