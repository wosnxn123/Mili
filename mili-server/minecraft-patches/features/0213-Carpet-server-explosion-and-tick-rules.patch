diff --git a/net/minecraft/world/level/NaturalSpawner.java b/net/minecraft/world/level/NaturalSpawner.java
index 99e4400..e591c57 100644
--- a/net/minecraft/world/level/NaturalSpawner.java
+++ b/net/minecraft/world/level/NaturalSpawner.java
@@ -497,11 +497,41 @@ public final class NaturalSpawner {
         ChunkPos pos = chunk.getPos();
         int x = pos.getMinBlockX() + level.random.nextInt(16);
         int z = pos.getMinBlockZ() + level.random.nextInt(16);
-        int topEmptyY = chunk.getHeight(Heightmap.Types.WORLD_SURFACE, x, z) + 1;
+        int surfaceY = chunk.getHeight(Heightmap.Types.WORLD_SURFACE, x, z);
+        if (fun.bm.mili.carpet.config.modules.GameplayCompatConfig.naturalSpawningUse13Heightmap) {
+            surfaceY = carpetSample13SpawnHeight(level, chunk, x, z, surfaceY);
+        }
+        int topEmptyY = surfaceY + 1;
         int y = Mth.randomBetweenInclusive(level.random, level.getMinY(), topEmptyY);
         return new BlockPos(x, y, z);
     }
 
+    public static int carpetSample13SpawnHeight(final Level level, final ChunkAccess chunk, final int x, final int z, final int initialY) {
+        BlockPos.MutableBlockPos cursor = new BlockPos.MutableBlockPos();
+        final int minY = level.getMinY();
+        int y = initialY;
+        while (y >= minY) {
+            cursor.set(x, y, z);
+            BlockState state = chunk.getBlockState(cursor);
+            net.minecraft.world.level.block.Block block = state.getBlock();
+            boolean special = fun.bm.mili.carpet.config.modules.GameplayCompatConfig.naturalSpawningUse13HeightmapExtra
+                && (block instanceof net.minecraft.world.level.block.piston.PistonBaseBlock
+                    || block instanceof net.minecraft.world.level.block.piston.PistonHeadBlock
+                    || block instanceof net.minecraft.world.level.block.SlimeBlock
+                    || block instanceof net.minecraft.world.level.block.HoneyBlock);
+            boolean ignored = special || (state.canOcclude() && state.useShapeForLightOcclusion()
+                ? !net.minecraft.world.phys.shapes.Shapes.faceShapeOccludes(
+                    state.getFaceOcclusionShape(Direction.UP), state.getFaceOcclusionShape(Direction.DOWN)
+                )
+                : state.getLightDampening() == 0);
+            if (!ignored) {
+                break;
+            }
+            --y;
+        }
+        return y;
+    }
+
