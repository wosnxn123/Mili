+    private int getCarpetDelay(final Level level, final BlockPos pos, final BlockState state) {
+        int delay = this.getDelay(state);
+        if (fun.bm.mili.carpet.config.modules.GameplayCompatConfig.repeaterHalfDelay && this instanceof RepeaterBlock && level.getBlockState(pos.below()).is(Blocks.REDSTONE_ORE)) {
+            return Math.max(1, delay / 2);
+        }
+        return delay;
+    }
