From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <A3167717663@hotmail.com>
Date: Sun, 22 Mar 2026 01:39:15 +0800
Subject: [PATCH] Wire renewable deepslate fluid conversions

Adapted from LophineLabs/Lophine 0131 (7a51f49a512f1b5465f15a905d3704754e4bed02).
See docs/upstream-carpet-26.3.md for the legacy references and scope.

diff --git a/net/minecraft/world/level/block/LiquidBlock.java b/net/minecraft/world/level/block/LiquidBlock.java
index 9f09de4fb17601a36f36e8a2d6c64297c9f4339d..969050166cc3d1ca0bcefdfe1b9b7a48c03dc490 100644
--- a/net/minecraft/world/level/block/LiquidBlock.java
+++ b/net/minecraft/world/level/block/LiquidBlock.java
@@ -222,6 +222,10 @@ public class LiquidBlock extends Block implements BucketPickup {
                 BlockPos neighbourPos = pos.relative(direction.getOpposite());
                 if (level.getFluidState(neighbourPos).is(FluidTags.WATER)) {
                     Block convertToBlock = level.getFluidState(pos).isSource() ? Blocks.OBSIDIAN : Blocks.COBBLESTONE;
+                    if (convertToBlock == Blocks.COBBLESTONE && fun.bm.mili.config.modules.function.OldFeatureConfig.renewableDeepslate
+                        && level.dimension() == Level.OVERWORLD && pos.getY() < 0) {
+                        convertToBlock = Blocks.COBBLED_DEEPSLATE;
+                    }
                     // CraftBukkit start
                     if (org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(level, pos, convertToBlock.defaultBlockState(), Block.UPDATE_ALL)) {
                         this.fizz(level, pos);
diff --git a/net/minecraft/world/level/material/LavaFluid.java b/net/minecraft/world/level/material/LavaFluid.java
index 885d375b4793c6ac69d48d43f85b7d317fc6a2eb..ac40363a9c026bd4d7ca6c3dcd6973f1595cd729 100644
--- a/net/minecraft/world/level/material/LavaFluid.java
+++ b/net/minecraft/world/level/material/LavaFluid.java
@@ -225,7 +225,9 @@ public abstract class LavaFluid extends FlowingFluid {
             if (this.is(FluidTags.LAVA) && fluidState.is(FluidTags.WATER)) {
                 if (state.getBlock() instanceof LiquidBlock) {
                     // CraftBukkit start
-                    if (!org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(level.getMinecraftWorld(), pos, Blocks.STONE.defaultBlockState(), net.minecraft.world.level.block.Block.UPDATE_ALL)) {
+                    final var product = fun.bm.mili.config.modules.function.OldFeatureConfig.renewableDeepslate
+                        && level.getMinecraftWorld().dimension() == Level.OVERWORLD && pos.getY() < 0 ? Blocks.DEEPSLATE : Blocks.STONE;
+                    if (!org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(level.getMinecraftWorld(), pos, product.defaultBlockState(), net.minecraft.world.level.block.Block.UPDATE_ALL)) {
                         return;
                     }
                     // CraftBukkit end
