+    }
+    private boolean isLocalSpawningPlayer(Player player) {
+        return !(player instanceof org.leavesmc.leaves.bot.ServerBot bot)
+            || (ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(bot)
+                && bot.level() == this && bot.level().getChunkIfLoaded(bot.chunkPosition().x(), bot.chunkPosition().z()) != null);
     }
     // Leaf end - Optimize nearby alive players for spawning
 
