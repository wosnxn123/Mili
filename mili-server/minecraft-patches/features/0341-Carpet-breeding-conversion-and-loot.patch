         } else if (!itemStack.is(ItemTags.PARROT_POISONOUS_FOOD)) {
             if (!this.isFlying() && this.isTame() && this.isOwnedBy(player)) {
                 if (!this.level().isClientSide()) {
@@ -303,7 +306,9 @@ public class Parrot extends ShoulderRidingEntity {
 
     @Override
     public boolean isFood(final ItemStack itemStack) {
-        return false;
+        String food = fun.bm.mili.carpet.config.modules.EntityGameplayConfig.breedableParrots;
+        return food != null && !"none".equalsIgnoreCase(food) && !itemStack.isEmpty() && !itemStack.is(ItemTags.PARROT_POISONOUS_FOOD)
+            && net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(itemStack.getItem()).toString().equals(food);
     }
 
     public static boolean checkParrotSpawnRules(
@@ -318,12 +323,14 @@ public class Parrot extends ShoulderRidingEntity {
 
     @Override
     public boolean canMate(final Animal partner) {
-        return false;
+        return fun.bm.mili.carpet.config.modules.EntityGameplayConfig.breedableParrots != null && !"none".equalsIgnoreCase(fun.bm.mili.carpet.config.modules.EntityGameplayConfig.breedableParrots) && this.isTame() && partner instanceof Parrot parrot
+            && parrot.isTame() && super.canMate(partner);
     }
 
     @Override
     public @Nullable AgeableMob getBreedOffspring(final ServerLevel level, final AgeableMob partner) {
-        return null;
+        return partner instanceof Parrot && fun.bm.mili.carpet.config.modules.EntityGameplayConfig.breedableParrots != null && !"none".equalsIgnoreCase(fun.bm.mili.carpet.config.modules.EntityGameplayConfig.breedableParrots)
+            ? EntityTypes.PARROT.create(level, EntitySpawnReason.BREEDING) : null;
     }
 
     @Override
diff --git a/net/minecraft/world/entity/monster/Creeper.java b/net/minecraft/world/entity/monster/Creeper.java
index abddc6b..b91bad8 100644
--- a/net/minecraft/world/entity/monster/Creeper.java
+++ b/net/minecraft/world/entity/monster/Creeper.java
@@ -174,9 +174,17 @@ public class Creeper extends Monster {
         return SoundEvents.CREEPER_DEATH;
     }
 
+    public boolean carpetCanDropSkull() {
+        return this.isPowered() && (fun.bm.mili.carpet.config.modules.EntityGameplayConfig.superChargedCreeper || !this.droppedSkulls);
+    }
+
+    public void carpetRecordSkullDrop() {
+        this.droppedSkulls = true;
+    }
+
     @Override
     public boolean killedEntityPreEvent(final ServerLevel level, final LivingEntity entity, final DamageSource source) { // Paper
-        if (this.shouldDropLoot(level) && this.isPowered() && !this.droppedSkulls) {
+        if (this.shouldDropLoot(level) && this.carpetCanDropSkull()) {
             entity.dropFromLootTable(level, source, false, BuiltInLootTables.CHARGED_CREEPER, itemStack -> {
                 entity.spawnAtLocation(level, itemStack);
                 entity.postDeathEventTasks.add(() -> this.droppedSkulls = true); // Paper
diff --git a/net/minecraft/world/entity/monster/Guardian.java b/net/minecraft/world/entity/monster/Guardian.java
