From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <noreply@users.noreply.github.com>
Date: Sat, 28 Nov 2026 00:00:00 +0000
Subject: [PATCH] Carpet: native breeding, conversion and death drops

Adapted from Lophine 7a51f49a512f1b5465f15a905d3704754e4bed02, Minecraft patches 0131-0134.
Retain EntityBreedEvent, conversion events and death drop lists; no script continuations.
See META-INF/licenses/carpet-26.3.txt for source and license notices.

diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 6a2f731..028bb81 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -1416,6 +1416,19 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         List<DefaultDrop> loot = new java.util.ArrayList<>(this.getInventory().getContainerSize()); // Paper - Restore vanilla drops behavior
         boolean keepInventory = this.level().getGameRules().get(GameRules.KEEP_INVENTORY) || this.isSpectator();
         if (!keepInventory) {
+            final net.minecraft.world.entity.monster.Creeper skullSource = fun.bm.mili.carpet.config.modules.EntityGameplayConfig.playerDropHead
+                && source.getEntity() instanceof net.minecraft.world.entity.monster.Creeper creeper
+                && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(creeper) && creeper.carpetCanDropSkull() ? creeper : null;
+            if (fun.bm.mili.carpet.config.modules.EntityGameplayConfig.headHunter || skullSource != null) {
+                ItemStack head = new ItemStack(net.minecraft.world.item.Items.PLAYER_HEAD);
+                head.set(net.minecraft.core.component.DataComponents.PROFILE, net.minecraft.world.item.component.ResolvableProfile.createResolved(this.getGameProfile()));
+                loot.add(new DefaultDrop(head, stack -> {
+                    if (this.spawnAtLocation(this.level(), stack) != null && skullSource != null
+                        && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(skullSource)) {
+                        skullSource.carpetRecordSkullDrop();
+                    }
+                }));
+            }
             for (ItemStack item : this.getInventory().getContents()) {
                 if (!item.isEmpty() && !EnchantmentHelper.has(item, net.minecraft.world.item.enchantment.EnchantmentEffectComponents.PREVENT_EQUIPMENT_DROP)) {
                     loot.add(new DefaultDrop(item, stack -> this.drop(stack, false, net.minecraft.util.Prediction.PREDICTED, true, false, null))); // Paper - Restore vanilla drops behavior; drop function taken from Inventory#dropAll (don't fire drop event)
diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 25d1311..1229855 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -1967,6 +1967,16 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         boolean playerKilled = this.lastHurtByPlayerMemoryTime > 0;
         if (this.shouldDropLoot(level)) {
             this.dropFromLootTable(level, source, playerKilled);
+            double scrapChance = fun.bm.mili.carpet.config.modules.EntityGameplayConfig.renewableNetheriteScrap();
+            if (scrapChance > 0 && this instanceof net.minecraft.world.entity.monster.zombie.ZombifiedPiglin piglin
+                && !piglin.isBaby() && this.getRandom().nextDouble() < scrapChance) {
+                this.spawnAtLocation(level, Items.NETHERITE_SCRAP);
+            }
+            double elytraChance = fun.bm.mili.carpet.config.modules.EntityGameplayConfig.renewableElytra();
+            if (elytraChance > 0 && this instanceof net.minecraft.world.entity.monster.Phantom
+                && source.getEntity() instanceof net.minecraft.world.entity.monster.Shulker && this.getRandom().nextDouble() < elytraChance) {
+                this.spawnAtLocation(level, Items.ELYTRA);
+            }
             if (fun.bm.mili.carpet.config.modules.GameplayCompatConfig.easyWitherSkeletonSkullDrop && this instanceof net.minecraft.world.entity.monster.skeleton.WitherSkeleton) {
                 this.spawnAtLocation(level, Items.WITHER_SKELETON_SKULL);
             }
