diff --git a/net/minecraft/world/entity/player/Inventory.java b/net/minecraft/world/entity/player/Inventory.java
index 068cecc..fc8c324 100644
--- a/net/minecraft/world/entity/player/Inventory.java
+++ b/net/minecraft/world/entity/player/Inventory.java
@@ -347,6 +347,23 @@ public class Inventory implements Container, Nameable {
     }
 
     public void tick() {
+        if (fun.bm.mili.carpet.config.modules.EntityGameplayConfig.forceRestock && this.player instanceof net.minecraft.server.level.ServerPlayer
+            && !this.player.isSpectator() && this.player.containerMenu == this.player.inventoryMenu) {
+            for (int slot = 0; slot < getSelectionSize(); slot++) {
+                ItemStack hotbar = this.items.get(slot);
+                if (!hotbar.isStackable() || hotbar.getCount() >= hotbar.getMaxStackSize()) continue;
+                for (int i = getSelectionSize(); i < this.items.size(); i++) {
+                    ItemStack source = this.items.get(i);
+                    if (source.isEmpty() || !ItemStack.isSameItemSameComponents(hotbar, source)) continue;
+                    int moved = Math.min(source.getCount(), hotbar.getMaxStackSize() - hotbar.getCount());
+                    hotbar.grow(moved);
+                    source.shrink(moved);
+                    if (source.isEmpty()) this.items.set(i, ItemStack.EMPTY);
+                    this.setChanged();
+                    if (hotbar.getCount() >= hotbar.getMaxStackSize()) break;
+                }
+            }
+        }
         for (int i = 0; i < this.items.size(); i++) {
             ItemStack itemStack = this.getItem(i);
             if (!itemStack.isEmpty()) {
diff --git a/net/minecraft/world/item/trading/MerchantOffer.java b/net/minecraft/world/item/trading/MerchantOffer.java
index a57c055..fc284ad 100644
--- a/net/minecraft/world/item/trading/MerchantOffer.java
+++ b/net/minecraft/world/item/trading/MerchantOffer.java
@@ -185,7 +185,7 @@ public class MerchantOffer {
     }
 
     public void increaseUses() {
-        this.uses++;
+        if (!this.carpetUnlimitedNormalStock()) this.uses++;
     }
 
     public int getDemand() {
@@ -216,8 +216,12 @@ public class MerchantOffer {
         return this.xp;
     }
 
+    private boolean carpetUnlimitedNormalStock() {
+        return this.maxUses > 0 && (fun.bm.mili.carpet.config.modules.EntityGameplayConfig.infiniteTrades || fun.bm.mili.carpet.config.modules.EntityGameplayConfig.villagerInfiniteTrade);
+    }
+
     public boolean isOutOfStock() {
-        return this.uses + this.voidTradeUses >= this.maxUses; // Mili - force void trade
+        return (this.carpetUnlimitedNormalStock() ? this.voidTradeUses : this.uses + this.voidTradeUses) >= this.maxUses; // Mili - force void trade
     }
 
     public void setToOutOfStock() {
@@ -264,7 +268,7 @@ public class MerchantOffer {
         ItemStack.STREAM_CODEC.encode(output, offer.getResult());
         ItemCost.OPTIONAL_STREAM_CODEC.encode(output, offer.getItemCostB());
         output.writeBoolean(offer.isOutOfStock());
-        output.writeInt(offer.getUses());
+        output.writeInt(offer.carpetUnlimitedNormalStock() ? offer.voidTradeUses : offer.getUses());
         output.writeInt(offer.getMaxUses());
         output.writeInt(offer.getXp());
         output.writeInt(offer.getSpecialPriceDiff());
