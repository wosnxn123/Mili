Subject: [PATCH] Carpet: native merchant and hotbar restocking

Adapted from Lophine 7a51f49a512f1b5465f15a905d3704754e4bed02, Minecraft patches 0131-0134.
Do not erase stored trade uses, replace merchant sessions or bypass purchase events.
See META-INF/licenses/carpet-26.3.txt for source and license notices.

diff --git a/net/minecraft/world/entity/ai/gossip/GossipContainer.java b/net/minecraft/world/entity/ai/gossip/GossipContainer.java
index 41f8df3..52c32a9 100644
--- a/net/minecraft/world/entity/ai/gossip/GossipContainer.java
+++ b/net/minecraft/world/entity/ai/gossip/GossipContainer.java
@@ -122,6 +122,15 @@ public class GossipContainer {
 
     public int getReputation(final UUID entity, final Predicate<GossipType> types) {
         GossipContainer.EntityGossips entry = this.gossips.get(entity);
+        if (fun.bm.mili.carpet.config.modules.EntityGameplayConfig.sharedVillagerDiscounts && types.test(GossipType.MAJOR_POSITIVE)) {
+            int otherReputation = entry == null ? 0 : entry.weightedValue(type -> types.test(type) && type != GossipType.MAJOR_POSITIVE);
+            int sharedReputation = 0;
+            for (GossipContainer.EntityGossips gossip : this.gossips.values()) {
+                sharedReputation += gossip.weightedValue(type -> type == GossipType.MAJOR_POSITIVE);
+                if (sharedReputation >= GossipType.MAJOR_POSITIVE.max * GossipType.MAJOR_POSITIVE.weight) break;
+            }
+            return otherReputation + Math.min(sharedReputation, GossipType.MAJOR_POSITIVE.max * GossipType.MAJOR_POSITIVE.weight);
+        }
         return entry != null ? entry.weightedValue(types) : 0;
     }
 
