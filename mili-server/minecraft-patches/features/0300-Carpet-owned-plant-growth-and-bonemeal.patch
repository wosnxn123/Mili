diff --git a/net/minecraft/world/level/block/FlowerBlock.java b/net/minecraft/world/level/block/FlowerBlock.java
--- a/net/minecraft/world/level/block/FlowerBlock.java
+++ b/net/minecraft/world/level/block/FlowerBlock.java
@@ -14,7 +14,7 @@
 import net.minecraft.world.phys.shapes.VoxelShape;
 import org.jspecify.annotations.Nullable;
 
-public class FlowerBlock extends VegetationBlock implements SuspiciousEffectHolder {
+public class FlowerBlock extends VegetationBlock implements SuspiciousEffectHolder, BonemealableBlock {
     private static final VoxelShape SHAPE = Block.column(6.0, 0.0, 10.0);
     private final SuspiciousStewEffects suspiciousStewEffects;
 
@@ -44,4 +44,24 @@
     public @Nullable MobEffectInstance getBeeInteractionEffect() {
         return null;
     }
+
+    @Override
+    public boolean isValidBonemealTarget(final net.minecraft.world.level.LevelReader level, final BlockPos pos, final BlockState state, final BonemealSource source) {
+        return fun.bm.mili.carpet.config.modules.WorldGameplayConfig.fertilizableSmallFlower
+            && (!(level instanceof net.minecraft.server.level.ServerLevel world) || fun.bm.mili.carpet.GameplayCompatRules.ownsLoaded(world, pos));
+    }
+
+    @Override
+    public boolean isBonemealSuccess(final net.minecraft.world.level.Level level, final net.minecraft.util.RandomSource random,
+                                     final BlockPos pos, final BlockState state, final BonemealSource source) {
+        return this.isValidBonemealTarget(level, pos, state, source);
+    }
+
+    @Override
+    public void performBonemeal(final net.minecraft.server.level.ServerLevel level, final net.minecraft.util.RandomSource random,
+                                 final BlockPos pos, final BlockState state, final BonemealSource source) {
+        if (this.isValidBonemealTarget(level, pos, state, source)) {
+            Block.popResource(level, pos, new net.minecraft.world.item.ItemStack(this));
+        }
+    }
 }
