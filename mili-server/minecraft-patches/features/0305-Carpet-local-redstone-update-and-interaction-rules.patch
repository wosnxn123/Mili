diff --git a/net/minecraft/world/level/block/ObserverBlock.java b/net/minecraft/world/level/block/ObserverBlock.java
--- a/net/minecraft/world/level/block/ObserverBlock.java
+++ b/net/minecraft/world/level/block/ObserverBlock.java
@@ -25,6 +25,33 @@
     public ObserverBlock(final BlockBehaviour.Properties properties) {
         super(properties);
         this.registerDefaultState(this.stateDefinition.any().setValue(FACING, Direction.SOUTH).setValue(POWERED, false));
+    }
+
+    @Override
+    protected net.minecraft.world.InteractionResult useItemOn(final net.minecraft.world.item.ItemStack item, final BlockState state,
+        final Level level, final BlockPos pos, final net.minecraft.world.entity.player.Player player,
+        final net.minecraft.world.InteractionHand hand, final net.minecraft.world.phys.BlockHitResult hit) {
+        if (!fun.bm.mili.carpet.config.modules.WorldGameplayConfig.canActivatesObserver || !player.mayBuild() || player.isShiftKeyDown()
+            || state.getValue(POWERED) || level.getBlockTicks().hasScheduledTick(pos, this)
+            || !(level instanceof net.minecraft.server.level.ServerLevel world)
+            || !fun.bm.mili.carpet.GameplayCompatRules.ownsLoaded(world, pos)) {
+            return super.useItemOn(item, state, level, pos, player, hand, hit);
+        }
+        final var type = item.getItem();
+        final net.minecraft.sounds.SoundEvent sound;
+        if (item.is(net.minecraft.world.item.Items.FLINT_AND_STEEL)) {
+            item.hurtAndBreak(1, player, hand);
+            sound = net.minecraft.sounds.SoundEvents.FLINTANDSTEEL_USE;
+        } else if (item.is(net.minecraft.world.item.Items.FIRE_CHARGE)) {
+            item.consume(1, player);
+            sound = net.minecraft.sounds.SoundEvents.FIRECHARGE_USE;
+        } else {
+            return super.useItemOn(item, state, level, pos, player, hand, hit);
+        }
+        if (level.getBlockState(pos) == state) this.startSignal(world, world, pos);
+        world.playSound(null, pos, sound, net.minecraft.sounds.SoundSource.BLOCKS, 1.0F, 1.0F);
+        player.awardStat(net.minecraft.stats.Stats.ITEM_USED.get(type));
+        return net.minecraft.world.InteractionResult.SUCCESS;
     }
 
     @Override
