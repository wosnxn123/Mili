 public class BarrierBlock extends Block implements SimpleWaterloggedBlock {
     public static final BooleanProperty WATERLOGGED = BlockStateProperties.WATERLOGGED;
+
+    @Override
+    protected void neighborChanged(final BlockState state, final net.minecraft.world.level.Level level, final BlockPos pos,
+        final Block block, final net.minecraft.world.level.redstone.@Nullable Orientation orientation, final boolean movedByPiston) {
+        final int remaining = fun.bm.mili.carpet.config.modules.WorldGameplayConfig.updateSuppressionBlock();
+        if (remaining >= 0 && level instanceof net.minecraft.server.level.ServerLevel world
+            && fun.bm.mili.carpet.GameplayCompatRules.ownsLoaded(world, pos)
+            && world.getCurrentWorldData().neighborUpdater instanceof net.minecraft.world.level.redstone.CollectingNeighborUpdater updater) {
+            final BlockState above = world.getBlockState(pos.above());
+            if (above.is(Blocks.ACTIVATOR_RAIL) && !above.getValue(PoweredRailBlock.POWERED)) {
+                world.scheduleTick(pos, this, 1);
+                updater.mili$limitRemainingUpdates(remaining);
+            }
+        }
+        super.neighborChanged(state, level, pos, block, orientation, movedByPiston);
+    }
+
+    @Override
+    protected void tick(final BlockState state, final net.minecraft.server.level.ServerLevel level, final BlockPos pos, final RandomSource random) {
+        if (fun.bm.mili.carpet.config.modules.WorldGameplayConfig.updateSuppressionBlock() < 0 || !fun.bm.mili.carpet.GameplayCompatRules.ownsLoaded(level, pos)) return;
+        final BlockPos abovePos = pos.above();
+        final BlockState rail = level.getBlockState(abovePos);
+        if (rail.is(Blocks.ACTIVATOR_RAIL) && !rail.getValue(PoweredRailBlock.POWERED)
+            && org.bukkit.craftbukkit.event.CraftEventFactory.callBinaryRedstoneChange(level, abovePos, true)
+            && level.getBlockState(abovePos) == rail) {
+            level.setBlock(abovePos, rail.setValue(PoweredRailBlock.POWERED, true), Block.UPDATE_CLIENTS | Block.UPDATE_KNOWN_SHAPE);
+        }
+    }
 
     protected BarrierBlock(final BlockBehaviour.Properties properties) {
         super(properties);
