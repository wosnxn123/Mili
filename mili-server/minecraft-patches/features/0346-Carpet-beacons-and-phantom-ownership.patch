From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <noreply@users.noreply.github.com>
Date: Sat, 28 Nov 2026 00:00:00 +0000
Subject: [PATCH] Carpet: owner-thread beacon effects and phantom budgets

Adapted from Lophine 7a51f49a512f1b5465f15a905d3704754e4bed02, Minecraft patches 0131-0134.
Beacon recipients are checked again on their owner; phantom budget is tied to native region spawning state.
See META-INF/licenses/carpet-26.3.txt for source and license notices.

diff --git a/net/minecraft/world/level/NaturalSpawner.java b/net/minecraft/world/level/NaturalSpawner.java
index 8067a99..24fc062 100644
--- a/net/minecraft/world/level/NaturalSpawner.java
+++ b/net/minecraft/world/level/NaturalSpawner.java
@@ -203,6 +203,17 @@ public final class NaturalSpawner {
     }
 
     // Paper start - Add mobcaps commands
+    public static boolean carpetMaySpawnPhantom(final ServerLevel level, final BlockPos pos) {
+        final MobCategory category = net.minecraft.world.entity.EntityTypes.PHANTOM.getCategory();
+        final int limit = level.getWorld().getSpawnLimit(org.bukkit.craftbukkit.util.CraftSpawnCategory.toBukkit(category));
+        if (limit <= 0) return false;
+        final var state = level.getChunkSource().getLastSpawnState();
+        if (state == null) return false;
+        return level.paperConfig().entities.spawning.perPlayerMobSpawns
+            ? state.canSpawnForCategoryGlobal(category, limit)
+            : state.canSpawnForCategoryGlobal(category, limit) && state.canSpawnForCategoryLocal(category, ChunkPos.containing(pos));
+    }
+
     public static int globalLimitForCategory(final ServerLevel level, final MobCategory category, final int spawnableChunkCount) {
         final int categoryLimit = level.getWorld().getSpawnLimitUnsafe(org.bukkit.craftbukkit.util.CraftSpawnCategory.toBukkit(category));
         if (categoryLimit < 1) {
@@ -709,6 +720,10 @@ public final class NaturalSpawner {
             }
         }
 
+        public void carpetCountPhantom(final Mob entity, final ChunkAccess chunk) {
+            this.afterSpawn(entity, chunk);
+        }
+
         private void afterSpawn(final Mob mob, final ChunkAccess chunk) {
             EntityType<?> type = mob.getType();
             BlockPos pos = mob.blockPosition();
diff --git a/net/minecraft/world/level/block/entity/BeaconBlockEntity.java b/net/minecraft/world/level/block/entity/BeaconBlockEntity.java
index ec1e65c..56346e0 100644
--- a/net/minecraft/world/level/block/entity/BeaconBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/BeaconBlockEntity.java
@@ -337,6 +337,32 @@ public class BeaconBlockEntity extends BlockEntity implements MenuProvider, Name
             int baseAmp = computeEffectAmplifier(levels, primaryPower, secondaryPower); // Paper - diff out applyEffects logic components - see below
 
             int durationTicks = computeEffectDuration(levels); // Paper - diff out applyEffects logic components - see below
+            if ((fun.bm.mili.carpet.config.modules.EntityGameplayConfig.beaconRangeExpand() != 0 || fun.bm.mili.carpet.config.modules.EntityGameplayConfig.beaconWorldHeight) && level instanceof net.minecraft.server.level.ServerLevel world) {
+                final int extra = fun.bm.mili.carpet.config.modules.EntityGameplayConfig.beaconRangeExpand();
+                final double width = Math.max(0.0, entity.getEffectRange() + extra);
+                final AABB original = new AABB(worldPosition).inflate(width);
+                final double yRadius = entity.getEffectRange();
+                final AABB bounds = new AABB(original.minX, fun.bm.mili.carpet.config.modules.EntityGameplayConfig.beaconWorldHeight ? level.getMinY() - 64.0 : worldPosition.getY() - yRadius,
+                    original.minZ, original.maxX, fun.bm.mili.carpet.config.modules.EntityGameplayConfig.beaconWorldHeight ? level.getMaxY() + 64.0 : worldPosition.getY() + 1.0 + yRadius + level.getHeight(), original.maxZ);
+                final BlockPos source = worldPosition.immutable();
+                final MobEffectInstance primary = new MobEffectInstance(primaryPower, durationTicks, baseAmp, true, true);
+                final MobEffectInstance secondary = hasSecondaryEffect(levels, primaryPower, secondaryPower)
+                    ? new MobEffectInstance(secondaryPower, durationTicks, 0, true, true) : null;
+                for (net.minecraft.server.level.ServerPlayer candidate : world.players()) {
+                    // Use the immutable position only as a hint; check the player's actual bounds on its owner.
+                    if (!bounds.inflate(2.0).contains(candidate.position())) continue;
+                    java.util.function.Consumer<net.minecraft.server.level.ServerPlayer> apply = player -> {
+                        if (player.level() != world || player.isRemoved() || player.isSpectator() || !bounds.intersects(player.getBoundingBox())) return;
+                        applyEffectsAndCallEvent(world, source, List.of(player), new MobEffectInstance(primary), true);
+                        if (secondary != null && player.level() == world && !player.isRemoved() && bounds.intersects(player.getBoundingBox())) {
+                            applyEffectsAndCallEvent(world, source, List.of(player), new MobEffectInstance(secondary), false);
+                        }
+                    };
+                    if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(candidate)) apply.accept(candidate);
+                    else candidate.getBukkitEntity().taskScheduler.schedule(apply, null, 1L);
+                }
+                return;
+            }
             List<Player> players = getHumansInRange(level, worldPosition, levels, entity); // Paper - diff out applyEffects logic components - see below
 
             applyEffectsAndCallEvent(level, worldPosition, players, new MobEffectInstance(primaryPower, durationTicks, baseAmp, true, true), true); // Paper - BeaconEffectEvent
diff --git a/net/minecraft/world/level/levelgen/PhantomSpawner.java b/net/minecraft/world/level/levelgen/PhantomSpawner.java
