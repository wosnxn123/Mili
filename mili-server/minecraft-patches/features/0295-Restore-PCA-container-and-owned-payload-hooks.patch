diff --git a/net/minecraft/world/level/block/entity/BlockEntity.java b/net/minecraft/world/level/block/entity/BlockEntity.java
--- a/net/minecraft/world/level/block/entity/BlockEntity.java
+++ b/net/minecraft/world/level/block/entity/BlockEntity.java
@@ -241,6 +241,16 @@
                 net.minecraft.world.level.block.CarpetLargeBarrel.updatePartnerComparators(level, worldPosition, blockState);
             }
         }
+        if (fun.bm.mili.config.modules.function.protocol.PcaSyncProtocolConfig.enable && level instanceof net.minecraft.server.level.ServerLevel world
+            && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(world, worldPosition)) {
+            final net.minecraft.world.level.chunk.LevelChunk chunk = world.getChunkIfLoaded(worldPosition);
+            if (chunk != null) {
+                final BlockEntity current = chunk.getBlockEntity(worldPosition);
+                if (current != null) {
+                    org.leavesmc.leaves.protocol.PcaSyncProtocol.syncBlockEntityToClient(current);
+                }
+            }
+        }
     }
 
     public BlockPos getBlockPos() {
