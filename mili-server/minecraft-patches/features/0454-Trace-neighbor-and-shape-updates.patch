From: Mili <noreply@mili.invalid>
Subject: [PATCH] Trace neighbor and shape updates

Extended watches observe actual queued/fan-out or chain-limited attempts and the common instant/queued dispatch path, including suppression, wire flags, plugin cancellation and callback results.

diff --git a/net/minecraft/world/level/redstone/CollectingNeighborUpdater.java b/net/minecraft/world/level/redstone/CollectingNeighborUpdater.java
--- a/net/minecraft/world/level/redstone/CollectingNeighborUpdater.java
+++ b/net/minecraft/world/level/redstone/CollectingNeighborUpdater.java
@@ -1,5 +1,6 @@
 package net.minecraft.world.level.redstone;
 
+import fun.bm.mili.carpet.timing.MicroTiming;
 import com.mojang.logging.LogUtils;
 import java.util.ArrayDeque;
 import java.util.ArrayList;
@@ -89,6 +90,17 @@
             LOGGER.error("Too many chained neighbor updates. Skipping the rest. First skipped position: {}", pos.toShortString());
         }
 
+        final var mili$timing = MicroTiming.capture(this.level, pos, true, false);
+        if (mili$timing != null) {
+            final String detail = switch (update) {
+                case ShapeUpdate shape -> "shape " + shape.direction + " flags=" + shape.updateFlags + " limit=" + shape.updateLimit;
+                case FullNeighborUpdate full -> "neighbor " + MicroTiming.blockKey(full.block) + " piston=" + full.movedByPiston;
+                case SimpleNeighborUpdate simple -> "neighbor " + MicroTiming.blockKey(simple.block);
+                case MultiNeighborUpdate multi -> "neighbor fan-out " + MicroTiming.blockKey(multi.sourceBlock) + " except=" + multi.skipDirection;
+                default -> "neighbor";
+            };
+            mili$timing.point("schedule update", (tooManyUpdates ? "chain limit " : "queued ") + detail);
+        }
         if (!runningAlready) {
             this.runUpdates();
         }
