diff --git a/net/minecraft/world/level/block/piston/PistonBaseBlock.java b/net/minecraft/world/level/block/piston/PistonBaseBlock.java
index 360967cae29cd3f54c7dc498a8d95148dafef653..c2e8ea2b2e5483a64c75871531bb7bc6945cbe17 100644
--- a/net/minecraft/world/level/block/piston/PistonBaseBlock.java
+++ b/net/minecraft/world/level/block/piston/PistonBaseBlock.java
@@ -115,6 +115,10 @@ public class PistonBaseBlock extends DirectionalBlock {
         }
     }
 
+    public boolean carpetHasNeighborSignal(final SignalGetter level, final BlockPos pos, final Direction pushDirection) {
+        return this.getNeighborSignal(level, pos, pushDirection);
+    }
+
     private boolean getNeighborSignal(final SignalGetter level, final BlockPos pos, final Direction pushDirection) {
         for (Direction direction : DIRECTIONS) {
             if (direction != pushDirection && level.hasSignal(pos.relative(direction), direction)) {
