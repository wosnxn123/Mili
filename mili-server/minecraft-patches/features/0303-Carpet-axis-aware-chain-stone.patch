From: Bacteriawa <A3167717663@hotmail.com>
Date: Sun, 22 Mar 2026 01:39:15 +0800
Subject: [PATCH] Carpet axis aware chain stone

From Lophine 7a51f49a, Minecraft 0131. See META-INF/licenses/carpet-26.3.txt.
Preserve the native piston solver and events; fail the extended movement before reading any unowned or unloaded position.

diff --git a/net/minecraft/world/level/block/piston/PistonStructureResolver.java b/net/minecraft/world/level/block/piston/PistonStructureResolver.java
--- a/net/minecraft/world/level/block/piston/PistonStructureResolver.java
+++ b/net/minecraft/world/level/block/piston/PistonStructureResolver.java
@@ -38,6 +38,7 @@
     public boolean resolve() {
         this.toPush.clear();
         this.toDestroy.clear();
+        if (!this.carpetOwns(this.startPos)) return false;
         BlockState nextState = this.level.getBlockState(this.startPos);
         if (!PistonBaseBlock.isPushable(nextState, this.level, this.startPos, this.pushDirection, false, this.pistonDirection)) {
             if (this.extending && nextState.getPistonPushReaction() == PushReaction.POPPED) {
@@ -62,17 +63,41 @@
         }
     }
 
+    private boolean carpetOwns(final BlockPos pos) {
+        return "false".equals(fun.bm.mili.carpet.config.modules.WorldGameplayConfig.chainStone()) || !(this.level instanceof net.minecraft.server.level.ServerLevel world)
+            || fun.bm.mili.carpet.GameplayCompatRules.ownsLoaded(world, pos);
+    }
+
+    private static boolean isChainStone(final BlockState state) {
+        return state.getBlock() instanceof net.minecraft.world.level.block.ChainBlock && !"false".equals(fun.bm.mili.carpet.config.modules.WorldGameplayConfig.chainStone());
+    }
+
+    private boolean sticksAlong(final BlockState state, final BlockState other, final BlockPos otherPos, final Direction fromState) {
+        if (!isChainStone(state)) return canStickToEachOther(state, other);
+        final var axis = state.getValue(net.minecraft.world.level.block.ChainBlock.AXIS);
+        if (axis != fromState.getAxis()) return false;
+        if ("stick_to_all".equals(fun.bm.mili.carpet.config.modules.WorldGameplayConfig.chainStone())) return true;
+        if (other.getBlock() instanceof net.minecraft.world.level.block.ChainBlock) {
+            return axis == other.getValue(net.minecraft.world.level.block.ChainBlock.AXIS);
+        }
+        if (other.is(Blocks.END_ROD)) {
+            return axis == other.getValue(net.minecraft.world.level.block.EndRodBlock.FACING).getAxis();
+        }
+        return net.minecraft.world.level.block.Block.canSupportCenter(this.level, otherPos, fromState.getOpposite());
+    }
+
     private static boolean isSticky(final BlockState state) {
-        return state.is(Blocks.SLIME_BLOCK) || state.is(Blocks.HONEY_BLOCK);
+        return isChainStone(state) || state.is(Blocks.SLIME_BLOCK) || state.is(Blocks.HONEY_BLOCK);
     }
 
     private static boolean canStickToEachOther(final BlockState state1, final BlockState state2) {
         return (!state1.is(Blocks.HONEY_BLOCK) || !state2.is(Blocks.SLIME_BLOCK))
             && (!state1.is(Blocks.SLIME_BLOCK) || !state2.is(Blocks.HONEY_BLOCK))
-            && (isSticky(state1) || isSticky(state2));
+            && (state1.is(Blocks.SLIME_BLOCK) || state1.is(Blocks.HONEY_BLOCK) || state2.is(Blocks.SLIME_BLOCK) || state2.is(Blocks.HONEY_BLOCK));
     }
 
     private boolean addBlockLine(final BlockPos start, final Direction direction) {
+        if (!this.carpetOwns(start)) return false;
         BlockState nextState = this.level.getBlockState(start);
         if (nextState.isAir()) {
             return true;
@@ -97,10 +122,11 @@
 
         while (isSticky(nextState)) {
             BlockPos pos = start.relative(this.pushDirection.getOpposite(), blockCount);
+            if (!this.carpetOwns(pos)) return false;
             BlockState previousState = nextState;
             nextState = this.level.getBlockState(pos);
             if (nextState.isAir()
-                || !canStickToEachOther(previousState, nextState)
+                || !this.sticksAlong(previousState, nextState, pos, this.pushDirection.getOpposite())
                 || !PistonBaseBlock.isPushable(nextState, this.level, pos, this.pushDirection, false, this.pushDirection.getOpposite())
                 || pos.equals(this.pistonPos)) {
                 break;
@@ -122,6 +148,7 @@
 
         while (true) {
             BlockPos pos = start.relative(this.pushDirection, i);
+            if (!this.carpetOwns(pos)) return false;
             int collisionPos = this.toPush.indexOf(pos);
             if (collisionPos > -1) {
                 this.reorderListAtCollision(blocksAdded, collisionPos);
@@ -179,8 +206,10 @@
         for (Direction direction : DIRECTIONS) {
             if (direction.getAxis() != this.pushDirection.getAxis()) {
                 BlockPos neighbourPos = fromPos.relative(direction);
+                if (isChainStone(fromState) && fromState.getValue(net.minecraft.world.level.block.ChainBlock.AXIS) != direction.getAxis()) continue;
+                if (!this.carpetOwns(neighbourPos)) return false;
                 BlockState neighbourState = this.level.getBlockState(neighbourPos);
-                if (canStickToEachOther(neighbourState, fromState) && !this.addBlockLine(neighbourPos, direction)) {
+                if (this.sticksAlong(fromState, neighbourState, neighbourPos, direction) && !this.addBlockLine(neighbourPos, direction)) {
                     return false;
                 }
             }
