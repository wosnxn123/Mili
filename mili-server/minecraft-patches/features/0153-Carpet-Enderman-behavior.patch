From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <A3167717663@hotmail.com>
Date: Sun, 22 Mar 2026 01:39:15 +0800
Subject: [PATCH] Carpet Enderman behavior

Adapted for Mili from LophineLabs/Lophine 0132/0133 (7a51f49a512f1b5465f15a905d3704754e4bed02).
See docs/upstream-carpet-26.3.md for provenance and scope.

diff --git a/net/minecraft/world/entity/monster/Enderman.java b/net/minecraft/world/entity/monster/Enderman.java
index b4f40fd199bd0fd8486311d9e3846912e57438d2..4702757c31ad97e8b278c2bff544ab7505e0f23f 100644
--- a/net/minecraft/world/entity/monster/Enderman.java
+++ b/net/minecraft/world/entity/monster/Enderman.java
@@ -224,7 +224,7 @@ public class Enderman extends Monster implements NeutralMob {
 
     private boolean isBeingStaredBy(final Player player) {
         // Paper start - EndermanAttackPlayerEvent
-        final boolean shouldAttack = this.isBeingStaredBy0(player);
+        final boolean shouldAttack = !fun.bm.mili.carpet.config.modules.GeneralCompatConfig.staringEndermanNotAngry && this.isBeingStaredBy0(player);
         final com.destroystokyo.paper.event.entity.EndermanAttackPlayerEvent event = new com.destroystokyo.paper.event.entity.EndermanAttackPlayerEvent((org.bukkit.entity.Enderman) getBukkitEntity(), (org.bukkit.entity.Player) player.getBukkitEntity());
         event.setCancelled(!shouldAttack);
         return event.callEvent();
@@ -279,6 +279,11 @@ public class Enderman extends Monster implements NeutralMob {
     }
 
     public boolean teleport() {
+        // Mili start - Carpet features
+        if (fun.bm.mili.carpet.config.modules.GeneralCompatConfig.endermanTeleportRandomlyDisabled) {
+            return false;
+        }
+        // Mili end - Carpet features
         if (!this.level().isClientSide() && this.isAlive()) {
             double xx = this.getX() + (this.random.nextDouble() - 0.5) * 64.0;
             double yy = this.getY() + (this.random.nextInt(64) - 32);
