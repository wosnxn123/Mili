diff --git a/net/minecraft/world/level/block/grower/TreeGrower.java b/net/minecraft/world/level/block/grower/TreeGrower.java
index 13797ac..674d84d 100644
--- a/net/minecraft/world/level/block/grower/TreeGrower.java
+++ b/net/minecraft/world/level/block/grower/TreeGrower.java
@@ -103,6 +103,14 @@ public final class TreeGrower {
     }
 
     private @Nullable ResourceKey<Feature> getConfiguredFeature(final RandomSource random, final boolean hasFlowers) {
+        // Carpet TIS Addition: 26.3 stores the ordinary oak choices in a weighted list.
+        int oakPercent = fun.bm.mili.carpet.config.modules.GameplayCompatConfig.oakBalloonPercent;
+        if (this == OAK && oakPercent > 0 && !hasFlowers) {
+            WeightedList<ResourceKey<Feature>> selected = WeightedList.of(
+                random.nextFloat() < oakPercent / 100.0F ? TreeFeatures.FANCY_OAK : TreeFeatures.OAK
+            );
+            return selected.getRandom(random).orElse(null);
+        }
         return hasFlowers && !this.flowerTrees.isEmpty() ? this.flowerTrees.getRandom(random).orElse(null) : this.trees.getRandom(random).orElse(null);
     }
 
