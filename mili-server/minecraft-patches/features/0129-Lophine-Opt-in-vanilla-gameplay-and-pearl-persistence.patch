+    private void mili$restoreEnderPearl(final CompoundTag tag) {
+        try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(this.problemPath(), LOGGER)) {
+            ValueInput input = TagValueInput.create(reporter, this.registryAccess(), tag);
+            ResourceKey<Level> dimension = input.read(ENDER_PEARL_DIMENSION_TAG, Level.RESOURCE_KEY_CODEC).orElse(null);
+            ServerLevel target = dimension == null ? null : this.server.getLevel(dimension);
+            UUID id = input.read("UUID", UUIDUtil.CODEC).orElse(null);
+            Vec3 pos = input.read("Pos", Vec3.CODEC).orElse(null);
+            // Same horizontal bounds as Entity.load: a clamped entity must not be inserted from the wrong region.
+            if (target == null || id == null || pos == null || !(Math.abs(pos.x) <= 3.0000512E7)
+                || !(Math.abs(pos.z) <= 3.0000512E7) || !Double.isFinite(pos.y)) {
+                LOGGER.warn("Skipping invalid saved ender pearl in dimension {}", dimension);
+                return;
+            }
+            final fun.bm.mili.utils.PlayerEnderPearls storage = this.mili$enderPearls;
+            if (target.paperConfig().misc.legacyEnderPearlBehavior || !storage.stageRestore(id, tag)) {
+                return;
+            }
+            ChunkPos chunk = ChunkPos.containing(BlockPos.containing(pos));
+            var reporterPath = this.problemPath();
+            this.server.getPlayerList().mili$afterPearlUnload(id, () ->
+                io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueOrExecuteTickTask(target, chunk.x(), chunk.z(), () -> {
+                if (storage.isClosing()) {
+                    return; // A quick disconnect saves the still-pending tag instead of spawning it.
+                }
+                try (ProblemReporter.ScopedCollector regionReporter = new ProblemReporter.ScopedCollector(reporterPath, LOGGER)) {
+                    ValueInput pearlInput = TagValueInput.create(regionReporter, target.registryAccess(), tag);
+                    Entity entity = EntityType.loadEntityRecursive(pearlInput, target, EntitySpawnReason.LOAD, net.minecraft.world.entity.EntityProcessor.NOP);
+                    if (entity instanceof ThrownEnderpearl pearl && pearl.mili$isOwnedBy(this) && target.addFreshEntity(pearl)) {
+                        ServerPlayer.placeEnderPearlTicket(target, pearl.chunkPosition());
+                        if (storage.isClosing() && !pearl.isRemoved()) {
+                            pearl.setRemoved(Entity.RemovalReason.UNLOADED_WITH_PLAYER, org.bukkit.event.entity.EntityRemoveEvent.Cause.PLAYER_QUIT);
+                        }
+                    }
+                } finally {
+                    storage.forget(id, null); // Keep already-published or frozen logout snapshots.
+                }
+            }));
+        }
     }
 
