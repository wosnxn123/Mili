 public abstract class PlayerList {
+    // Mili - a rapid relog must wait for the old entity to leave its region before restoring the same UUID.
+    private final java.util.concurrent.ConcurrentHashMap<UUID, java.util.concurrent.CompletableFuture<Void>> mili$unloadingPearls = new java.util.concurrent.ConcurrentHashMap<>();
+
+    public void mili$afterPearlUnload(final UUID id, final Runnable enqueueRestore) {
+        java.util.concurrent.CompletableFuture<Void> unloading = this.mili$unloadingPearls.get(id);
+        if (unloading == null) {
+            enqueueRestore.run();
+        } else {
+            // Do not enqueue a chunk/region task from inside the entity scheduler's retired callback.
+            unloading.thenRunAsync(enqueueRestore);
+        }
+    }
+
+    private void mili$unloadPearl(final UUID id, final io.papermc.paper.threadedregions.EntityScheduler scheduler, final fun.bm.mili.utils.PlayerEnderPearls storage) {
+        var unloading = new java.util.concurrent.CompletableFuture<Void>();
+        this.mili$unloadingPearls.put(id, unloading);
+        Runnable done = () -> {
+            unloading.complete(null);
+            this.mili$unloadingPearls.remove(id, unloading);
+        };
+        if (!scheduler.schedule((Entity entity) -> {
+            try {
+                if (entity instanceof ThrownEnderpearl pearl) {
+                    pearl.mili$unloadOnOwnerQuit(storage);
+                }
+            } finally {
+                done.run();
+            }
+        }, ignored -> done.run(), 1L)) {
+            done.run();
+        }
+    }
