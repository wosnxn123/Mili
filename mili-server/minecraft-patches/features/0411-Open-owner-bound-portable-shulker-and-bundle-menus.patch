diff --git a/net/minecraft/world/inventory/PortableContainerMenu.java b/net/minecraft/world/inventory/PortableContainerMenu.java
new file mode 100644
index 0000000000000000000000000000000000000000..0e1a16dacc8e641fe0cdba59e40f57e57144ecbb
--- /dev/null
+++ b/net/minecraft/world/inventory/PortableContainerMenu.java
@@ -0,0 +1,266 @@
+package net.minecraft.world.inventory;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import fun.bm.mili.carpet.config.modules.ContainerR2Config;
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.SimpleContainer;
+import net.minecraft.world.SimpleMenuProvider;
+import net.minecraft.world.entity.player.Inventory;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.item.BlockItem;
+import net.minecraft.world.item.BundleItem;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.component.ItemContainerContents;
+import net.minecraft.world.level.block.ShulkerBoxBlock;
+
+/** A session tied to one exact stack in the opening player's inventory. */
+public final class PortableContainerMenu extends ShulkerBoxMenu {
+    private final Backing backing;
+
+    private PortableContainerMenu(final int id, final Inventory inventory, final Backing backing) {
+        super(backing.size == 54 ? MenuType.GENERIC_9x6 : backing.bundle ? MenuType.GENERIC_9x3 : MenuType.SHULKER_BOX,
+            id, inventory, backing, backing.size / 9, stack -> canStore(stack, backing.bundle));
+        this.backing = backing;
+        backing.menu = this;
+    }
+
+    public static boolean isShulker(final ItemStack stack) {
+        return !stack.isEmpty() && stack.getItem() instanceof BlockItem block && block.getBlock() instanceof ShulkerBoxBlock;
+    }
+
+    private static boolean usableShulker(final ItemStack stack) {
+        return isShulker(stack) && stack.getCount() == 1 && !stack.has(DataComponents.LOCK)
+            && !stack.has(DataComponents.CONTAINER_LOOT) && !stack.has(DataComponents.BLOCK_ENTITY_DATA);
+    }
+
+    private static boolean canStore(final ItemStack stack, final boolean bundle) {
+        return stack.isEmpty() || stack.getItem().canFitInsideContainerItems() && (!bundle || !(stack.getItem() instanceof BundleItem));
+    }
+
+    static int shulkerSlots(final ItemStack stack) {
+        return ContainerR2Config.largeShulkerBox || stack.getOrDefault(DataComponents.CONTAINER, ItemContainerContents.EMPTY)
+            .itemCopies().skip(27).anyMatch(item -> !item.isEmpty()) ? 54 : 27;
+    }
+
+    public static boolean tryUse(final Player player, final InteractionHand hand, final boolean bundle) {
+        final int size = bundle ? ContainerR2Config.bundleSlots() : ContainerR2Config.quickShulker ? 27 : 0;
+        if (size == 0) return false;
+        final ItemStack source = player.getItemInHand(hand);
+        if (bundle ? !(source.getItem() instanceof BundleItem) || source.getCount() != 1 : !usableShulker(source)) return false;
+        if (player instanceof ServerPlayer owner) {
+            final int index = hand == InteractionHand.MAIN_HAND ? owner.getInventory().getSelectedSlot() : Inventory.SLOT_OFFHAND;
+            open(owner, index, source, bundle, bundle ? size : shulkerSlots(source));
+        }
+        // Even if InventoryOpenEvent is cancelled, don't use a second interaction on the same packet.
+        return true;
+    }
+
+    private static void open(final ServerPlayer owner, final int index, final ItemStack source, final boolean bundle, final int size) {
+        if (!TickThread.isTickThreadFor(owner) || owner.hasDisconnected() || owner.isSpectator() || !owner.isAlive() || owner.getInventory().getItem(index) != source) return;
+        final Backing backing = new Backing(owner, index, source, bundle, size);
+        try {
+            owner.openMenu(new SimpleMenuProvider((id, inventory, player) -> new PortableContainerMenu(id, inventory, backing), source.getHoverName()));
+        } finally {
+            backing.opening = false;
+        }
+    }
+
+    static boolean tryInventoryClick(final AbstractContainerMenu menu, final Player player, final Slot slot) {
+        if (!ContainerR2Config.quickShulker || !(player instanceof ServerPlayer owner) || owner.isSpectator()
+            || !TickThread.isTickThreadFor(owner) || owner.hasDisconnected() || owner.containerMenu != menu || menu instanceof PortableContainerMenu
+            || slot.getClass() != Slot.class || slot.container != owner.getInventory() || slot.getContainerSlot() >= 36
+            || !slot.allowModification(player)) return false;
+        final ItemStack inSlot = slot.getItem();
+        final ItemStack carried = menu.getCarried();
+        if (inSlot == carried) return false;
+        if (usableShulker(inSlot)) {
+            if (carried.isEmpty()) {
+                open(owner, slot.getContainerSlot(), inSlot, false, shulkerSlots(inSlot));
+            } else if (!isShulker(carried)) {
+                transferInto(inSlot, carried);
+                slot.setChanged();
+            } else {
+                return false;
+            }
+            return true;
+        }
+        if (!usableShulker(carried) || isShulker(inSlot)) return false;
+        if (inSlot.isEmpty()) {
+            final List<ItemStack> items = contents(carried);
+            for (int i = 0, end = Math.min(shulkerSlots(carried), items.size()); i < end; ++i) {
+                final ItemStack item = items.get(i);
+                if (item.isEmpty()) continue;
+                if (slot.mayPlace(item)) {
+                    final int amount = Math.min(item.getCount(), slot.getMaxStackSize(item));
+                    if (amount > 0) {
+                        slot.setByPlayer(item.split(amount));
+                        write(carried, items);
+                    }
+                }
+                break;
+            }
+        } else {
+            transferInto(carried, inSlot);
+            slot.setChanged();
+        }
+        return true;
+    }
+
+    private static List<ItemStack> contents(final ItemStack stack) {
+        return new ArrayList<>(stack.getOrDefault(DataComponents.CONTAINER, ItemContainerContents.EMPTY).itemCopies().toList());
+    }
+
+    private static void write(final ItemStack source, final List<ItemStack> contents) {
+        source.set(DataComponents.CONTAINER, ItemContainerContents.fromItems(contents));
+    }
+
+    static int transferInto(final ItemStack box, final ItemStack source) {
+        if (source.isEmpty() || !canStore(source, false)) return 0;
+        final List<ItemStack> items = contents(box);
+        final int size = shulkerSlots(box);
+        while (items.size() < size) items.add(ItemStack.EMPTY);
+        final int original = source.getCount();
+        final int limit = source.getMaxStackSize();
+        for (int i = 0; i < size && !source.isEmpty(); ++i) {
+            final ItemStack existing = items.get(i);
+            if (!existing.isEmpty() && ItemStack.isSameItemSameComponents(existing, source)) {
+                final int moved = Math.min(source.getCount(), Math.max(0, limit - existing.getCount()));
+                existing.grow(moved);
+                source.shrink(moved);
+            }
+        }
+        for (int i = 0; i < size && !source.isEmpty(); ++i) {
+            if (items.get(i).isEmpty()) items.set(i, source.split(limit));
+        }
+        if (source.getCount() != original) write(box, items);
+        return original - source.getCount();
+    }
+
+    static ItemContainerContents replaceVisible(final ItemContainerContents original, final List<ItemStack> visible) {
+        final List<ItemStack> result = new ArrayList<>(visible);
+        if (original != null) original.itemCopies().skip(visible.size()).forEach(result::add);
+        return ItemContainerContents.fromItems(result);
+    }
+
+    boolean isSourceSlot(final Slot slot) {
+        return slot.container == this.backing.owner.getInventory() && slot.getContainerSlot() == this.backing.index;
+    }
+
+    boolean allowInput(final Player player, final int rawSlot, final int button, final ContainerInput input) {
+        return this.stillValid(player)
+            && input != ContainerInput.QUICK_CRAFT // Don't reserve cursor items across a re-entrant Bukkit drag callback.
+            && (input != ContainerInput.SWAP || this.backing.index != button)
+            && (rawSlot < 0 || rawSlot >= this.slots.size() || !this.isSourceSlot(this.getSlot(rawSlot)));
+    }
+
+    @Override
+    public boolean stillValid(final Player player) {
+        return player == this.backing.owner && this.backing.isActive();
+    }
+
+    @Override
+    public boolean canTakeItemForPickAll(final ItemStack carried, final Slot target) {
+        return !this.isSourceSlot(target) && super.canTakeItemForPickAll(carried, target);
+    }
+
+    @Override
+    public ItemStack quickMoveStack(final Player player, final int rawSlot) {
+        return this.stillValid(player) && !this.isSourceSlot(this.getSlot(rawSlot)) ? super.quickMoveStack(player, rawSlot) : ItemStack.EMPTY;
+    }
+
+    @Override
+    public void removed(final Player player) {
+        if (player != this.backing.owner) return;
+        this.backing.closed = true;
+        super.removed(player);
+    }
+
+    private static final class Backing extends SimpleContainer {
+        private final ServerPlayer owner;
+        private final int index;
+        private final ItemStack source;
+        private final boolean bundle;
+        private final int size;
+        private ItemContainerContents expected;
+        private PortableContainerMenu menu;
+        private boolean opening = true;
+        private boolean closed;
+
+        private Backing(final ServerPlayer owner, final int index, final ItemStack source, final boolean bundle, final int size) {
+            super(size);
+            this.owner = owner;
+            this.index = index;
+            this.source = source;
+            this.bundle = bundle;
+            this.size = size;
+            this.expected = source.get(DataComponents.CONTAINER);
+            if (this.expected != null) {
+                final var items = this.expected.itemCopies().limit(size).iterator();
+                for (int i = 0; items.hasNext(); ++i) super.getContents().set(i, items.next());
+            }
+        }
+
+        private boolean isSourceValid() {
+            return TickThread.isTickThreadFor(this.owner) && !this.closed && !this.owner.hasDisconnected() && this.owner.isAlive() && !this.owner.isSpectator()
+                && this.owner.getInventory().getItem(this.index) == this.source
+                && (this.bundle ? ContainerR2Config.bundleSlots() == this.size && this.source.getCount() == 1
+                    : ContainerR2Config.quickShulker && usableShulker(this.source))
+                && this.source.get(DataComponents.CONTAINER) == this.expected;
+        }
+
+        private boolean isActive() {
+            return this.menu != null && this.owner.containerMenu == this.menu && this.isSourceValid();
+        }
+
+        @Override
+        public List<ItemStack> getContents() {
+            return (this.opening || this.owner.containerMenu == this.menu) && this.isSourceValid()
+                ? super.getContents().stream().map(ItemStack::copy).toList() : java.util.Collections.nCopies(this.size, ItemStack.EMPTY);
+        }
+
+        @Override
+        public ItemStack getItem(final int slot) {
+            if (this.isActive()) return super.getItem(slot);
+            // InventoryOpenEvent can inspect a copy, but cannot write into a not-yet-open menu.
+            return this.opening && this.isSourceValid() ? super.getItem(slot).copy() : ItemStack.EMPTY;
+        }
+
+        @Override
+        public ItemStack removeItem(final int slot, final int amount) {
+            return this.isActive() ? super.removeItem(slot, amount) : ItemStack.EMPTY;
+        }
+
+        @Override
+        public ItemStack removeItemNoUpdate(final int slot) {
+            if (!this.isActive()) return ItemStack.EMPTY;
+            final ItemStack removed = super.removeItemNoUpdate(slot);
+            this.setChanged();
+            return removed;
+        }
+
+        @Override
+        public void setItem(final int slot, final ItemStack stack) {
+            if (this.isActive() && canStore(stack, this.bundle)) super.setItem(slot, stack);
+        }
+
+        @Override
+        public void clearContent() {
+            if (this.isActive()) super.clearContent();
+        }
+
+        @Override
+        public void setChanged() {
+            if (!this.isActive()) return;
+            final ItemContainerContents updated = replaceVisible(this.expected, super.getContents());
+            if (updated.equals(this.expected == null ? ItemContainerContents.EMPTY : this.expected)) return;
+            this.source.set(DataComponents.CONTAINER, updated);
+            this.expected = this.source.get(DataComponents.CONTAINER);
+            this.owner.getInventory().setChanged();
+            super.setChanged();
+        }
+    }
+}
