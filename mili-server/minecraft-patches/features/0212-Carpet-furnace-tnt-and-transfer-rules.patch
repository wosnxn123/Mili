diff --git a/net/minecraft/world/entity/item/PrimedTnt.java b/net/minecraft/world/entity/item/PrimedTnt.java
index e0ba289..0bc1ce2 100644
--- a/net/minecraft/world/entity/item/PrimedTnt.java
+++ b/net/minecraft/world/entity/item/PrimedTnt.java
@@ -77,8 +77,12 @@ public class PrimedTnt extends Entity implements TraceableEntity {
         if (fun.bm.mili.carpet.config.modules.GeneralCompatConfig.tntPrimerMomentumRemoved) {
             this.setDeltaMovement(0.0, 0.20000000298023224D, 0.0);
         } else {
-            this.setDeltaMovement(-Math.sin(rot) * 0.02, 0.2F, -Math.cos(rot) * 0.02);
+            double angle = fun.bm.mili.carpet.config.modules.GameplayCompatConfig.hardcodeTNTangle();
+            double launchAngle = angle == -1.0 ? rot : angle;
+            this.setDeltaMovement(-Math.sin(launchAngle) * 0.02, 0.2F, -Math.cos(launchAngle) * 0.02);
         }
+        double power = fun.bm.mili.carpet.config.modules.GameplayCompatConfig.tntPowerController();
+        if (power >= 0.0) this.explosionPower = (float) power;
         this.setFuse(getConfiguredFuseTime());
         this.xo = x;
         this.yo = y;
