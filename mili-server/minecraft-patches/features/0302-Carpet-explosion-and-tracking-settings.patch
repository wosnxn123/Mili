+    // Fabric Carpet's face traversal uses double precision and a distinct RNG order.
+    private static final double[] CARPET_CACHED_RAYS = createCarpetRays();
+
+    private static double[] createCarpetRays() {
+        it.unimi.dsi.fastutil.doubles.DoubleArrayList rays = new it.unimi.dsi.fastutil.doubles.DoubleArrayList();
+        for (int plane = 0; plane <= 15; plane += 15) {
+            for (int z = 0; z <= 15; z++) {
+                for (int x = 0; x <= 15; x++) {
+                    addCarpetRay(rays, x, plane, z);
+                }
+            }
+        }
+        for (int plane = 0; plane <= 15; plane += 15) {
+            for (int z = 0; z <= 15; z++) {
+                for (int y = 1; y <= 14; y++) {
+                    addCarpetRay(rays, plane, y, z);
+                }
+            }
+        }
+        for (int plane = 0; plane <= 15; plane += 15) {
+            for (int x = 1; x <= 14; x++) {
+                for (int y = 1; y <= 14; y++) {
+                    addCarpetRay(rays, x, y, plane);
+                }
+            }
+        }
+        return rays.toDoubleArray();
+    }
+
+    private static void addCarpetRay(final it.unimi.dsi.fastutil.doubles.DoubleArrayList rays, final int x, final int y, final int z) {
+        double dx = x / 15.0D * 2.0D - 1.0D;
+        double dy = y / 15.0D * 2.0D - 1.0D;
+        double dz = z / 15.0D * 2.0D - 1.0D;
+        double length = Math.sqrt(dx * dx + dy * dy + dz * dz);
+        rays.add(dx / length * 0.3D);
+        rays.add(dy / length * 0.3D);
+        rays.add(dz / length * 0.3D);
+    }
+
