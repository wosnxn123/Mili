From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Libalpm64 <libalpm@proton.me>
Date: Tue, 11 Aug 2026 21:04:34 +0800
Subject: [PATCH] Luminol: Add secure seed V2 with Blake3


diff --git a/net/minecraft/world/level/levelgen/RandomState.java b/net/minecraft/world/level/levelgen/RandomState.java
index 85ea3ec73fb5474b000d6bc50eddbb8c06d09f49..81854a3fa8b5df7fa5d93bf520213208f6cae8b3 100644
--- a/net/minecraft/world/level/levelgen/RandomState.java
+++ b/net/minecraft/world/level/levelgen/RandomState.java
@@ -29,6 +29,8 @@ public final class RandomState {
     private static final int MAX_BUFFER_AGE_TICKS = 20;
     private final long seed;
     private final PositionalRandomFactory random;
+    private final PositionalRandomFactory aquiferRandom; // Luminol - Add secure seed V2 with Blake3
+    private final PositionalRandomFactory oreRandom; // Luminol - Add secure seed V2 with Blake3
     private final HolderGetter<NormalNoise> noises;
     private final NoiseRouter router;
     private final MaterialSystem materialSystem;
@@ -63,7 +65,24 @@ public final class RandomState {
     ) {
         WorldgenRandom.Algorithm randomAlgorithm = useLegacyRandom ? WorldgenRandom.Algorithm.LEGACY : WorldgenRandom.Algorithm.XOROSHIRO;
         this.seed = seed;
-        this.random = randomAlgorithm.newInstance(seed).forkPositional();
+        // Luminol start - Add secure seed V2 with Blake3
+        final long[] secureWorldSeed = (me.earthme.luminol.config.modules.function.SecureSeedConfig.enabled && me.earthme.luminol.config.modules.function.SecureSeedConfig.version == 2)
+            ? su.plo.matter.HashingV2.expandLevelSeedTo1024Bits(seed)
+            : null;
+
+        long terrainSeed = (me.earthme.luminol.config.modules.function.SecureSeedConfig.enabled && me.earthme.luminol.config.modules.function.SecureSeedConfig.version == 2)
+            ? su.plo.matter.HashingV2.getTerrainSeed(secureWorldSeed, su.plo.matter.HashingV2.TerrainType.BASE_TERRAIN)
+            : seed;
+        long aquiferSeed = (me.earthme.luminol.config.modules.function.SecureSeedConfig.enabled && me.earthme.luminol.config.modules.function.SecureSeedConfig.version == 2)
+            ? su.plo.matter.HashingV2.getTerrainSeed(secureWorldSeed, su.plo.matter.HashingV2.TerrainType.AQUIFER)
+            : seed;
+        long oreSeed = (me.earthme.luminol.config.modules.function.SecureSeedConfig.enabled && me.earthme.luminol.config.modules.function.SecureSeedConfig.version == 2)
+            ? su.plo.matter.HashingV2.getTerrainSeed(secureWorldSeed, su.plo.matter.HashingV2.TerrainType.ORE)
+            : seed;
+        // Luminol end
+        this.random = randomAlgorithm.newInstance(terrainSeed).forkPositional(); // Luminol - Add secure seed V2 with Blake3
+        this.aquiferRandom = randomAlgorithm.newInstance(aquiferSeed).forkPositional(); // Luminol - Add secure seed V2 with Blake3
+        this.oreRandom = randomAlgorithm.newInstance(oreSeed).forkPositional(); // Luminol - Add secure seed V2 with Blake3
         this.noises = noises;
         this.router = router;
         this.noiseInstances = new ConcurrentHashMap<>();
@@ -72,6 +91,12 @@ public final class RandomState {
         this.densityFunctionCompiler = new DensityFunctionCompiler(
             new DensityFunction.CompileContext() {
                 private RandomSource newLegacyInstance(final long seedOffset) {
+                    // Luminol start - Add secure seed V2 with Blake3
+                    if (me.earthme.luminol.config.modules.function.SecureSeedConfig.enabled && me.earthme.luminol.config.modules.function.SecureSeedConfig.version == 2) {
+                        long climateSeed = su.plo.matter.HashingV2.getTerrainSeed(secureWorldSeed, su.plo.matter.HashingV2.TerrainType.CLIMATE);
+                        return new su.plo.matter.WorldgenCryptoRandom(0, 0, su.plo.matter.Globals.Salt.UNDEFINED, climateSeed + seedOffset);
+                    }
+                    // Luminol end
                     return new LegacyRandomSource(seed + seedOffset);
                 }
 
@@ -93,7 +118,11 @@ public final class RandomState {
 
                 @Override
                 public RandomSource createEndIslandRandom() {
-                    return new LegacyRandomSource(seed);
+                    // Luminol start - Add secure seed V2 with Blake3
+                    return new LegacyRandomSource((me.earthme.luminol.config.modules.function.SecureSeedConfig.enabled && me.earthme.luminol.config.modules.function.SecureSeedConfig.version == 2)
+                        ? su.plo.matter.HashingV2.getTerrainSeed(secureWorldSeed, su.plo.matter.HashingV2.TerrainType.SURFACE)
+                        : seed);
+                    // Luminol end
                 }
             }
         );
@@ -122,6 +151,14 @@ public final class RandomState {
     }
 
     public PositionalRandomFactory getOrCreateRandomFactory(final Identifier name) {
+        // Luminol start - Add secure seed V2 with Blake3; named 26.3 factory consumers
+        if (name.equals(Identifier.withDefaultNamespace("aquifer"))) {
+            return this.aquiferRandom;
+        }
+        if (name.equals(Identifier.withDefaultNamespace("ore"))) {
+            return this.oreRandom;
+        }
+        // Luminol end
         return this.positionalRandoms.computeIfAbsent(name, key -> this.random.fromHashOf(name).forkPositional());
     }
 
