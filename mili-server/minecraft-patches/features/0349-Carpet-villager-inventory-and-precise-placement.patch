From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <noreply@users.noreply.github.com>
Date: Sat, 28 Nov 2026 00:00:00 +0000
Subject: [PATCH] Carpet: stock villager inventory menu and precise placements

Adapted from Lophine 7a51f49a512f1b5465f15a905d3704754e4bed02, Minecraft patches 0131-0134.
Use the native 3x3 inventory protocol and original pre-spawn/placement callbacks.
See META-INF/licenses/carpet-26.3.txt for source and license notices.

diff --git a/net/minecraft/world/entity/EntityType.java b/net/minecraft/world/entity/EntityType.java
index 2bf7eab..ddb20fa 100644
--- a/net/minecraft/world/entity/EntityType.java
+++ b/net/minecraft/world/entity/EntityType.java
@@ -173,6 +173,19 @@ public class EntityType<T extends Entity> implements EntityTypeTest<Entity, T>,
         return this.spawn(level, postSpawnConfig, spawnPos, spawnReason, tryMoveDown, movedUp, createSpawnReason); // CraftBukkit
     }
 
+    public @Nullable T carpetSpawnFromEgg(final ServerLevel level, final ItemStack itemStack, final @Nullable LivingEntity user,
+        final BlockPos pos, final boolean tryMoveDown, final boolean movedUp, final Vec3 click) {
+        final var reason = org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.SPAWNER_EGG;
+        TypedEntityData<EntityType<?>> data = itemStack.get(DataComponents.ENTITY_DATA);
+        PostSpawnProcessor<T> config = data != null && !data.contains("Paper.SpawnReason")
+            ? appendCustomEntityStackConfig(appendComponentsConfig(entity -> entity.spawnReason = reason, itemStack), level, itemStack, user)
+            : createDefaultStackConfig(level, itemStack, user);
+        return this.spawn(level, config.andThen(entity -> {
+            Vec3 desired = fun.bm.mili.carpet.EntityGameplayRules.precisePlacement(pos, click, entity.getY());
+            entity.snapTo(desired.x, desired.y, desired.z, entity.getYRot(), entity.getXRot());
+        }), pos, EntitySpawnReason.SPAWN_ITEM_USE, tryMoveDown, movedUp, reason);
+    }
+
     public static <T extends Entity> PostSpawnProcessor<T> createDefaultStackConfig(
         final Level level, final ItemStack itemStack, final @Nullable LivingEntity user
     ) {
