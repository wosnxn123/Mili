+        if (fun.bm.mili.carpet.config.modules.EntityGameplayConfig.openVillagerInventory && player instanceof net.minecraft.server.level.ServerPlayer serverPlayer
+            && player.isShiftKeyDown() && hand == InteractionHand.MAIN_HAND
+            && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this)
