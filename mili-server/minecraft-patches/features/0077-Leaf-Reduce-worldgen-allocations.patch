From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mrhua269 <mrhua269@gmail.com>
Date: Tue, 11 Aug 2026 20:46:19 +0800
Subject: [PATCH] Leaf: Reduce worldgen allocations


diff --git a/net/minecraft/world/level/levelgen/material/rule/SequenceRule.java b/net/minecraft/world/level/levelgen/material/rule/SequenceRule.java
index a9cee750a9df27ba1a773445cd105a76c731d03b..e492dfec2fc68979b049bf44a109ce65ba858832 100644
--- a/net/minecraft/world/level/levelgen/material/rule/SequenceRule.java
+++ b/net/minecraft/world/level/levelgen/material/rule/SequenceRule.java
@@ -29,14 +29,14 @@ public record SequenceRule(List<MaterialRule> sequence) implements MaterialRule
         }
 
         return (blockX, blockY, blockZ) -> {
-            for (RuleEvaluator rule : sequence) {
-                BlockState state = rule.tryApply(blockX, blockY, blockZ);
-                if (state != null) {
-                    return state;
-                }
+            // Leaf start - Reduce worldgen allocations; compiled evaluator array
+            BlockState state = null;
+            int length = sequence.length;
+            for (int i = 0; state == null && i < length; i++) {
+                state = sequence[i].tryApply(blockX, blockY, blockZ);
             }
-
-            return null;
+            return state;
+            // Leaf end - Reduce worldgen allocations
         };
     }
 }
