From: Mili <noreply@mili.invalid>
Subject: [PATCH] Add region-local block tick phases

Trace native random block/fluid callbacks and block-entity tick dispatch, without reporting wall time, block-entity contents, or global tick order.

diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -993,8 +993,9 @@
             } finally { foliaProfiler.stopTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.ENTITY_TICK); } // Folia - profiler
             if (this.paperConfig().unsupportedSettings.ticking.blockEntities) { // Paper - option to disable ticking
             profiler.popPush("blockEntities");
-            foliaProfiler.startTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.TILE_ENTITY); try { // Folia - profiler
-            this.tickBlockEntities();
+            foliaProfiler.startTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.TILE_ENTITY); // Folia - profiler
+            try (var trace = MicroTiming.phase(this, MicroTiming.Phase.BLOCK_ENTITIES)) {
+                this.tickBlockEntities();
             } finally { foliaProfiler.stopTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.TILE_ENTITY); } // Folia - profiler
             profiler.pop();
             } // Paper - option to disable ticking
@@ -1135,11 +1136,23 @@
                 // do not use a mutable pos, as some random tick implementations store the input without calling immutable()!
                 final BlockPos pos = new BlockPos((location & 15) | offsetX, ((location >>> (4 + 4)) & 15) | offsetY, ((location >>> 4) & 15) | offsetZ);
 
-                state.randomTick((ServerLevel)(Object)this, pos, simpleRandom);
+                final var mili$timing = MicroTiming.capture(this, pos, false, true);
+                try (var trace = mili$timing == null ? null : mili$timing.begin("random block tick", state.toString())) {
+                    state.randomTick((ServerLevel)(Object)this, pos, simpleRandom);
+                    if (trace != null) {
+                        trace.result("callback returned");
+                    }
+                }
                 if (doubleTickFluids) {
                     final FluidState fluidState = state.getFluidState();
                     if (fluidState.isRandomlyTicking()) {
-                        fluidState.randomTick((ServerLevel)(Object)this, pos, simpleRandom);
+                        final var fluidTiming = MicroTiming.capture(this, pos, false, true);
+                        try (var trace = fluidTiming == null ? null : fluidTiming.begin("random fluid tick", fluidState.toString())) {
+                            fluidState.randomTick((ServerLevel)(Object)this, pos, simpleRandom);
+                            if (trace != null) {
+                                trace.result("callback returned");
+                            }
+                        }
                     }
                 }
             }
@@ -1167,7 +1180,9 @@
 
         profiler.popPush("tickBlocks");
         if (tickSpeed > 0) {
-            this.optimiseRandomTick(chunk, tickSpeed); // Paper - optimise random ticking
+            try (var trace = MicroTiming.phase(this, MicroTiming.Phase.RANDOM_TICKS)) {
+                this.optimiseRandomTick(chunk, tickSpeed); // Paper - optimise random ticking
+            }
         }
 
         profiler.pop();
