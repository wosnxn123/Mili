From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <A3167717663@hotmail.com>
Date: Sun, 22 Mar 2026 01:39:15 +0800
Subject: [PATCH] Carpet AMS campfire compost and coral rules

Adapted for Mili from LophineLabs/Lophine 0132 (7a51f49a512f1b5465f15a905d3704754e4bed02).
See docs/upstream-carpet-26.3.md for provenance and scope.

diff --git a/net/minecraft/world/level/block/BaseCoralPlantTypeBlock.java b/net/minecraft/world/level/block/BaseCoralPlantTypeBlock.java
index b9ee73d8670c11dc0d62282eead1872647fb3881..3036c856286f3c8d707a05e38d5c6d2de9b66aa5 100644
--- a/net/minecraft/world/level/block/BaseCoralPlantTypeBlock.java
+++ b/net/minecraft/world/level/block/BaseCoralPlantTypeBlock.java
@@ -31,6 +31,11 @@ public abstract class BaseCoralPlantTypeBlock extends Block implements SimpleWat
     protected void tryScheduleDieTick(
         final BlockState state, final BlockGetter level, final ScheduledTickAccess ticks, final RandomSource random, final BlockPos pos
     ) {
+        // Mili start - Carpet features
+        if (fun.bm.mili.carpet.config.modules.GeneralCompatConfig.undyingCoral) {
+            return;
+        }
+        // Mili end - Carpet features
         if (!scanForWater(state, level, pos)) {
             ticks.scheduleTick(pos, this, 60 + random.nextInt(40));
         }
diff --git a/net/minecraft/world/level/block/CampfireBlock.java b/net/minecraft/world/level/block/CampfireBlock.java
index fabf3dca600862410aa0cafd396dbf1905975b83..627bded6b1ad3433795e792edaddac6bf7f636f8 100644
--- a/net/minecraft/world/level/block/CampfireBlock.java
+++ b/net/minecraft/world/level/block/CampfireBlock.java
@@ -148,7 +148,7 @@ public class CampfireBlock extends BaseEntityBlock implements SimpleWaterloggedB
         return this.defaultBlockState()
             .setValue(WATERLOGGED, replacedWater)
             .setValue(SIGNAL_FIRE, this.isSmokeSource(level.getBlockState(pos.below())))
-            .setValue(LIT, !replacedWater)
+            .setValue(LIT, !replacedWater && !fun.bm.mili.carpet.config.modules.GeneralCompatConfig.extinguishedCampfire) // Mili - Carpet features
             .setValue(FACING, context.getHorizontalDirection());
     }
 
diff --git a/net/minecraft/world/level/block/ComposterBlock.java b/net/minecraft/world/level/block/ComposterBlock.java
index efc2c315340d76cfc6959e6710b64108b03902d1..e541e986fdb3627caa5a35b0f8653274140573cf 100644
