index 0000000000000000000000000000000000000000..92c8730c530889df2ea68f9692f84ab08e96f189
--- /dev/null
+++ b/net/minecraft/world/level/block/CarpetLargeBarrel.java
@@ -0,0 +1,194 @@
+/*
