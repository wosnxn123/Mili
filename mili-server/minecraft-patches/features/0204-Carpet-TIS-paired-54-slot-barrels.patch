+package net.minecraft.world.level.block;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import fun.bm.mili.carpet.config.modules.GeneralCompatConfig;
+import fun.bm.mili.config.modules.function.ContainerExpansionConfig;
+import java.util.function.Function;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.CompoundContainer;
+import net.minecraft.world.Container;
+import net.minecraft.world.MenuProvider;
+import net.minecraft.world.entity.ContainerUser;
+import net.minecraft.world.entity.player.Inventory;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.inventory.AbstractContainerMenu;
+import net.minecraft.world.inventory.ChestMenu;
+import net.minecraft.world.inventory.MenuType;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.entity.BarrelBlockEntity;
+import net.minecraft.world.level.block.entity.BaseContainerBlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.craftbukkit.inventory.CraftInventoryDoubleChest;
+import org.jspecify.annotations.Nullable;
+
+public final class CarpetLargeBarrel {
+    private static final int HALF_SIZE = 27;
+
+    private CarpetLargeBarrel() {
+    }
+
+    public static boolean pairingEnabled() {
+        return GeneralCompatConfig.largeBarrel && ContainerExpansionConfig.barrelRows == 3;
+    }
+
+    public static @Nullable Container getContainer(final Level level, final BlockPos pos) {
+        if (!(level instanceof ServerLevel serverLevel)) {
+            return null;
+        }
+        BarrelBlockEntity barrel = getLoadedBarrel(serverLevel, pos);
+        if (barrel == null) {
+            return null;
+        }
+        Pair pair = pair(barrel, ContainerExpansionConfig.barrelRows, other -> getLoadedBarrel(serverLevel, other));
+        return pair == null ? barrel : pair;
+    }
+
+    public static @Nullable MenuProvider getMenuProvider(final Level level, final BlockPos pos) {
+        return switch (getContainer(level, pos)) {
+            case Pair pair -> CraftInventoryDoubleChest.Provider.wrap(pair, pair);
+            case BarrelBlockEntity barrel -> barrel;
+            case null, default -> null;
+        };
+    }
+
+    private static @Nullable BarrelBlockEntity getLoadedBarrel(final ServerLevel level, final BlockPos pos) {
+        if (!TickThread.isTickThreadFor(level, pos) || level.isOutsideBuildHeight(pos)) {
+            return null;
+        }
+        LevelChunk chunk = level.getChunkIfLoaded(pos);
+        if (chunk == null || !(chunk.getBlockState(pos).getBlock() instanceof BarrelBlock)
+            || !(chunk.getBlockEntity(pos) instanceof BarrelBlockEntity barrel) || barrel.isRemoved()) {
+            return null;
+        }
+        return barrel;
+    }
+
+    static @Nullable Pair pair(final BarrelBlockEntity barrel, final int configuredRows,
+                               final Function<BlockPos, @Nullable BarrelBlockEntity> lookup) {
+        if (configuredRows != 3 || !isPairHalf(barrel)) {
+            return null;
+        }
+        final Direction facing = barrel.getBlockState().getValue(BarrelBlock.FACING);
+        final BarrelBlockEntity other = partner(barrel.getBlockPos(), facing, lookup);
+        if (other == null) {
+            return null;
+        }
+        return facing.getAxisDirection() == Direction.AxisDirection.NEGATIVE ? new Pair(barrel, other) : new Pair(other, barrel);
+    }
+
+    private static boolean isPairHalf(final BarrelBlockEntity barrel) {
+        return !barrel.isRemoved() && barrel.getContainerSize() == HALF_SIZE && barrel.getBlockState().getBlock() instanceof BarrelBlock;
+    }
+
+    private static @Nullable BarrelBlockEntity partner(final BlockPos pos, final Direction facing,
+                                                       final Function<BlockPos, @Nullable BarrelBlockEntity> lookup) {
+        final BlockPos otherPos = pos.relative(facing.getOpposite());
+        // Both halves must keep one tick owner even after a region split, and
+        // must load and unload together while the menu is open.
+        if ((pos.getX() >> 4) != (otherPos.getX() >> 4) || (pos.getZ() >> 4) != (otherPos.getZ() >> 4)) {
+            return null;
+        }
+        final BarrelBlockEntity other = lookup.apply(otherPos);
+        return other != null && isPairHalf(other) && other.getBlockState().getValue(BarrelBlock.FACING) == facing.getOpposite()
+            ? other : null;
+    }
+
+    // Read the counterpart of the passed state, not of the current world state:
+    // the old half may already have been rotated or removed when called.
+    public static void updatePartnerComparators(final Level level, final BlockPos pos, final BlockState state) {
+        if (!(level instanceof ServerLevel serverLevel) || ContainerExpansionConfig.barrelRows != 3
+            || !(state.getBlock() instanceof BarrelBlock) || !TickThread.isTickThreadFor(level, pos)) {
+            return;
+        }
+        BarrelBlockEntity other = partner(pos, state.getValue(BarrelBlock.FACING), target -> getLoadedBarrel(serverLevel, target));
+        if (other != null) {
+            level.updateNeighbourForOutputSignal(other.getBlockPos(), other.getBlockState().getBlock());
+        }
+    }
+
+    public static final class Pair extends CompoundContainer implements MenuProvider {
+        private final BarrelBlockEntity first;
+        private final BarrelBlockEntity second;
+        private boolean started;
+
+        private Pair(final BarrelBlockEntity first, final BarrelBlockEntity second) {
+            super(first, second);
+            this.first = first;
+            this.second = second;
+        }
+
+        public boolean isCurrent() {
+            if (!(this.first.getLevel() instanceof ServerLevel level) || !pairingEnabled()
+                || getLoadedBarrel(level, this.first.getBlockPos()) != this.first || !isPairHalf(this.first)) {
+                return false;
+            }
+            return partner(this.first.getBlockPos(), this.first.getBlockState().getValue(BarrelBlock.FACING),
+                target -> getLoadedBarrel(level, target)) == this.second;
+        }
+
+        @Override
+        public @Nullable AbstractContainerMenu createMenu(final int syncId, final Inventory inventory, final Player player) {
+            if (player.level() != this.first.getLevel() || !this.isCurrent()
+                || !checkLock(this.first, player) || !this.isCurrent() || !checkLock(this.second, player) || !this.isCurrent()) {
+                return null;
+            }
+            this.first.unpackLootTable(player);
+            if (!this.isCurrent()) {
+                return null;
+            }
+            this.second.unpackLootTable(player);
+            return this.isCurrent() ? this.createMenu(syncId, inventory) : null;
+        }
+
+        ChestMenu createMenu(final int syncId, final Inventory inventory) {
+            return new ChestMenu(MenuType.GENERIC_9x6, syncId, inventory, this, 6) {
+                @Override
+                public boolean stillValid(final Player player) {
+                    return player.level() == Pair.this.first.getLevel() && Pair.this.isCurrent() && super.stillValid(player);
+                }
+            };
+        }
+
+        private static boolean checkLock(final BarrelBlockEntity barrel, final Player player) {
+            if (barrel.canOpen(player)) {
+                return true;
+            }
+            if (!player.isSpectator()) {
+                BaseContainerBlockEntity.sendChestLockedNotifications(Vec3.atCenterOf(barrel.getBlockPos()), player, barrel.getDisplayName());
+            }
+            return false;
+        }
+
+        @Override
+        public void startOpen(final ContainerUser user) {
+            if (!this.started && this.isCurrent()) {
+                this.started = true;
+                super.startOpen(user);
+            }
+        }
+
+        @Override
+        public void stopOpen(final ContainerUser user) {
+            Level level = this.first.getLevel();
+            if (this.started && level != null && TickThread.isTickThreadFor(level, this.first.getBlockPos())) {
+                this.started = false;
+                super.stopOpen(user);
+            }
+        }
+
+        @Override
+        public Component getDisplayName() {
+            return this.first.getCustomName() != null ? this.first.getDisplayName() : this.second.getDisplayName();
+        }
+    }
+}
