@@ -0,0 +1,238 @@
+package net.minecraft.world.level.block.piston;
+
+import fun.bm.mili.carpet.GameplayCompatRules;
+import fun.bm.mili.carpet.config.modules.WorldR2Config;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.util.ProblemReporter;
+import net.minecraft.world.level.block.BarrelBlock;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.CarpetLargeBarrel;
+import net.minecraft.world.level.block.ChestBlock;
+import net.minecraft.world.level.block.EntityBlock;
+import net.minecraft.world.level.block.entity.RandomizableContainerBlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.BlockStateProperties;
+import net.minecraft.world.level.block.state.properties.ChestType;
+import net.minecraft.world.level.block.state.properties.PistonType;
+import net.minecraft.world.level.redstone.ExperimentalRedstoneUtils;
+import net.minecraft.world.level.storage.TagValueInput;
+import org.jspecify.annotations.Nullable;
+
+/** A single-owner transfer; no callbacks or inventory drops between clearing sources and installing cargo. */
+final class MovablePistonCargo {
+    private static final int QUIET = Block.UPDATE_SKIP_ALL_SIDEEFFECTS | Block.UPDATE_CLIENTS;
+
+    private MovablePistonCargo() {
+    }
+
+    static boolean enabled() {
+        return WorldR2Config.movableBlockEntities;
+    }
+
+    static boolean supports(final BlockState state) {
+        // Explicit allowlist: these inventories have ordinary, separate block/item drops.
+        return state.is(Blocks.CHEST) || state.is(Blocks.TRAPPED_CHEST) || state.is(Blocks.BARREL);
+    }
+
+    static @Nullable Direction candidatePartner(final BlockState state) {
+        if (state.getBlock() instanceof ChestBlock && state.getValue(ChestBlock.TYPE) != ChestType.SINGLE) {
+            return ChestBlock.getConnectedDirection(state);
+        }
+        if (state.getBlock() instanceof BarrelBlock && CarpetLargeBarrel.pairingEnabled()) {
+            return state.getValue(BarrelBlock.FACING).getOpposite();
+        }
+        return null;
+    }
+
+    static boolean matchingPair(final BlockPos pos, final BlockState state, final Direction side, final BlockState other) {
+        if (!other.is(state.getBlock()) || candidatePartner(other) != side.getOpposite()) return false;
+        return state.getBlock() instanceof ChestBlock
+            ? other.getValue(ChestBlock.FACING) == state.getValue(ChestBlock.FACING)
+                && other.getValue(ChestBlock.TYPE) != state.getValue(ChestBlock.TYPE)
+            : sameChunk(pos, pos.relative(side));
+    }
+
+    private static boolean sameChunk(final BlockPos a, final BlockPos b) {
+        return a.getX() >> 4 == b.getX() >> 4 && a.getZ() >> 4 == b.getZ() >> 4;
+    }
+
+    private static boolean ownsPhysicsFootprint(final ServerLevel level, final BlockPos pos) {
+        // Neighbour/comparator notifications can walk an extra block beyond the target.
+        return !level.isOutsideBuildHeight(pos) && fun.bm.mili.carpet.WorldGameplayRules.ownsLoadedBox(level,
+            pos.getX() - 2, pos.getZ() - 2, pos.getX() + 2, pos.getZ() + 2);
+    }
+
+    static @Nullable Plan prepare(final ServerLevel level, final BlockPos piston, final Direction facing,
+                                  final boolean extending, final boolean sticky, final List<BlockPos> pushed,
+                                  final List<BlockPos> broken) {
+        final var data = level.getCurrentWorldData();
+        if (!broken.isEmpty() || level.isDebug() || data.captureBlockStates || data.captureTreeGeneration
+            || fun.bm.mili.config.modules.experiment.RedStoneConfig.oldBlockRemoveBehaviour) return null;
+        final var plan = new Plan(level, piston, facing, extending, sticky);
+        final var destinations = plan.before;
+        final BlockPos arm = piston.relative(facing);
+        if (!ownsPhysicsFootprint(level, piston) || !ownsPhysicsFootprint(level, arm)) return null;
+        destinations.put(piston, level.getBlockState(piston));
+        destinations.put(arm, level.getBlockState(arm));
+        for (BlockPos src : pushed) {
+            final BlockPos dst = src.relative(plan.movement);
+            if (!ownsPhysicsFootprint(level, src) || !ownsPhysicsFootprint(level, dst) || !level.getWorldBorder().isWithinBounds(dst)) return null;
+            final BlockState state = level.getBlockState(src);
+            final RandomizableContainerBlockEntity container;
+            Direction pair = null;
+            if (state.hasBlockEntity()) {
+                if (!supports(state) || !(level.getBlockEntity(src) instanceof RandomizableContainerBlockEntity found)
+                    || found.isRemoved() || !found.getViewers().isEmpty()) return null;
+                container = found;
+                final Direction candidate = candidatePartner(state);
+                if (candidate != null) {
+                    final BlockPos partner = src.relative(candidate);
+                    if (!GameplayCompatRules.ownsLoaded(level, partner)) return null;
+                    final BlockState partnerState = level.getBlockState(partner);
+                    destinations.put(partner, partnerState);
+                    if (matchingPair(src, state, candidate, partnerState)) {
+                        if (!pushed.contains(partner) || !sameChunk(src, partner) || !sameChunk(dst, dst.relative(candidate))) return null;
+                        pair = candidate;
+                    } else if (state.getBlock() instanceof ChestBlock) {
+                        return null; // An orphaned double-chest half must not move as a stale pair.
+                    }
+                }
+            } else {
+                container = null;
+            }
+            destinations.put(src, state);
+            destinations.put(dst, level.getBlockState(dst));
+            if (!pushed.contains(dst) && !level.getBlockState(dst).isAir()
+                && !(!extending && dst.equals(arm) && level.getBlockState(dst).is(Blocks.PISTON_HEAD))) return null;
+            plan.moves.add(new Move(src, dst, state, container, pair));
+        }
+        return plan;
+    }
+
+    private record Move(BlockPos source, BlockPos destination, BlockState state,
+                        @Nullable RandomizableContainerBlockEntity sourceInventory, @Nullable Direction pair) {
+    }
+
+    static final class Plan {
+        final ServerLevel level;
+        final BlockPos piston;
+        final Direction facing;
+        final Direction movement;
+        final boolean extending;
+        final boolean sticky;
+        final Map<BlockPos, BlockState> before = new LinkedHashMap<>();
+        final List<Move> moves = new ArrayList<>();
+
+        Plan(final ServerLevel level, final BlockPos piston, final Direction facing, final boolean extending, final boolean sticky) {
+            this.level = level;
+            this.piston = piston;
+            this.facing = facing;
+            this.movement = extending ? facing : facing.getOpposite();
+            this.extending = extending;
+            this.sticky = sticky;
+        }
+
+        boolean commit() {
+            // Piston events run above this point. Recheck the complete footprint and all inventory identities.
+            if (!enabled() || this.level.getCurrentWorldData().captureBlockStates || this.level.getCurrentWorldData().captureTreeGeneration
+                || fun.bm.mili.config.modules.experiment.RedStoneConfig.oldBlockRemoveBehaviour) return false;
+            for (var entry : this.before.entrySet()) {
+                if (!GameplayCompatRules.ownsLoaded(this.level, entry.getKey()) || this.level.getBlockState(entry.getKey()) != entry.getValue()) return false;
+            }
+            final Map<BlockPos, PistonMovingBlockEntity> carriers = new LinkedHashMap<>();
+            final BlockState moving = Blocks.MOVING_PISTON.defaultBlockState().setValue(MovingPistonBlock.FACING, this.facing);
+            for (final Move move : this.moves) {
+                final PistonMovingBlockEntity carrier = new PistonMovingBlockEntity(move.destination(), moving, move.state(), this.facing, this.extending, false);
+                if (move.sourceInventory() != null) {
+                    final var original = move.sourceInventory();
+                    if (this.level.getBlockEntity(move.source()) != original || original.isRemoved() || !original.getViewers().isEmpty()) return false;
+                    final var cargo = ((EntityBlock) move.state().getBlock()).newBlockEntity(move.destination(), move.state());
+                    if (!(cargo instanceof RandomizableContainerBlockEntity inventory) || inventory.getContainerSize() != original.getContainerSize()) return false;
+                    inventory.loadWithComponents(TagValueInput.create(ProblemReporter.DISCARDING, this.level.registryAccess(), original.saveWithoutMetadata(this.level.registryAccess())));
+                    carrier.miliSetCargo(inventory, move.pair());
+                }
+                carriers.put(move.destination(), carrier);
+            }
+            final BlockPos arm = this.piston.relative(this.facing);
+            if (this.extending) {
+                final PistonType type = this.sticky ? PistonType.STICKY : PistonType.DEFAULT;
+                final BlockState head = Blocks.PISTON_HEAD.defaultBlockState().setValue(PistonHeadBlock.FACING, this.facing).setValue(PistonHeadBlock.TYPE, type);
+                final BlockState movingHead = moving.setValue(MovingPistonBlock.TYPE, type);
+                carriers.put(arm, new PistonMovingBlockEntity(arm, movingHead, head, this.facing, true, true));
+            }
+
+            for (final Move move : this.moves) {
+                this.level.setBlock(move.source(), Blocks.AIR.defaultBlockState(), QUIET);
+                if (move.sourceInventory() != null) {
+                    move.sourceInventory().clearContent();
+                    move.sourceInventory().setLootTable(null);
+                }
+            }
+            for (final var entry : carriers.entrySet()) {
+                this.level.setBlock(entry.getKey(), entry.getValue().getBlockState(), QUIET);
+                this.level.setBlockEntity(entry.getValue());
+            }
+
+            // Restore the usual observable effects only after every moved inventory has a single owner.
+            final var orientation = ExperimentalRedstoneUtils.initialOrientation(this.level, this.movement, null);
+            for (final Move move : this.moves) {
+                final BlockState present = this.level.getBlockState(move.source());
+                move.state().affectNeighborsAfterRemoval(this.level, move.source(), true);
+                move.state().updateIndirectNeighbourShapes(this.level, move.source(), Block.UPDATE_CLIENTS);
+                present.updateNeighbourShapes(this.level, move.source(), Block.UPDATE_CLIENTS);
+                this.level.updateNeighborsAt(move.source(), move.state().getBlock(), orientation);
+                if (move.state().hasAnalogOutputSignal()) this.level.updateNeighbourForOutputSignal(move.source(), move.state().getBlock());
+            }
+            if (this.extending) this.level.updateNeighborsAt(arm, Blocks.PISTON_HEAD, orientation);
+            return true;
+        }
+    }
+
+    static void finish(final ServerLevel level, final PistonMovingBlockEntity carrier) {
+        final BlockPos pos = carrier.getBlockPos();
+        if (!GameplayCompatRules.ownsLoaded(level, pos) || level.getBlockEntity(pos) != carrier
+            || !level.getBlockState(pos).is(Blocks.MOVING_PISTON)) return;
+        PistonMovingBlockEntity partner = null;
+        final Direction pair = carrier.miliCargoPartner();
+        if (pair != null && sameChunk(pos, pos.relative(pair)) && GameplayCompatRules.ownsLoaded(level, pos.relative(pair))
+            && level.getBlockState(pos.relative(pair)).is(Blocks.MOVING_PISTON)
+            && level.getBlockEntity(pos.relative(pair)) instanceof PistonMovingBlockEntity other && other.miliHasCargo()
+            && other.miliCargoPartner() == pair.getOpposite() && other.getPushDirection() == carrier.getPushDirection()
+            && other.getMovedState().is(carrier.getMovedState().getBlock())) {
+            partner = other;
+        }
+        // Install both halves before any shape updates. If a half was destroyed independently, unpair the survivor.
+        land(level, carrier, partner != null);
+        if (partner != null) land(level, partner, true);
+        notifyLanding(level, carrier);
+        if (partner != null) notifyLanding(level, partner);
+    }
+
+    private static void land(final ServerLevel level, final PistonMovingBlockEntity carrier, final boolean paired) {
+        final BlockPos pos = carrier.getBlockPos();
+        final var inventory = carrier.miliTakeCargo();
+        if (inventory == null) return;
+        BlockState state = carrier.getMovedState();
+        if (!paired && state.getBlock() instanceof ChestBlock) state = state.setValue(ChestBlock.TYPE, ChestType.SINGLE);
+        if (state.hasProperty(BlockStateProperties.WATERLOGGED)) state = state.setValue(BlockStateProperties.WATERLOGGED, false);
+        level.removeBlockEntity(pos);
+        level.setBlock(pos, state, QUIET);
+        level.setBlockEntity(inventory);
+    }
+
+    private static void notifyLanding(final ServerLevel level, final PistonMovingBlockEntity carrier) {
+        final BlockPos pos = carrier.getBlockPos();
+        if (!ownsPhysicsFootprint(level, pos)) return;
+        final BlockState state = level.getBlockState(pos);
+        state.updateNeighbourShapes(level, pos, Block.UPDATE_CLIENTS);
+        level.updateNeighborsAt(pos, state.getBlock(), ExperimentalRedstoneUtils.initialOrientation(level, carrier.getPushDirection(), null));
+        level.updateNeighbourForOutputSignal(pos, state.getBlock());
+    }
+}
