+    private boolean miliExistingNetherPortalLookup;
+
     protected boolean portalToAsync(ServerLevel destination, BlockPos portalPos, boolean takePassengers,
                                     PortalType type, java.util.function.Consumer<Entity> teleportComplete) {
         ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this, "Cannot portal entity async");
-        if (!((ServerLevel)this.level).isAllowedToEnterPortal(destination)
+        if (this.miliExistingNetherPortalLookup || !((ServerLevel)this.level).isAllowedToEnterPortal(destination)
             || !this.canPortalAsync(destination, takePassengers)) {
             return false;
         }
@@ -5106,6 +5146,35 @@ public abstract class Entity
             return false;
         }
         // Luminol end
+        if (type == PortalType.NETHER && !fun.bm.mili.carpet.WorldR2Rules.mayCreateNetherPortal(this)) {
+            final ServerLevel origin = (ServerLevel) this.level();
+            final BlockPos entry = portalPos.immutable();
+            final var lookup = new ca.spottedleaf.concurrentutil.completable.CallbackCompletable<TeleportTransition>();
+            final var scheduler = this.getBukkitEntity().taskScheduler;
+            this.miliExistingNetherPortalLookup = true;
+            lookup.addWaiter((exit, failure) -> scheduler.schedule((Entity current) -> {
+                this.miliExistingNetherPortalLookup = false;
+                if (failure == null && exit != null && this.level() == origin && !this.isRemoved()
+                    && this.getBoundingBox().intersects(new AABB(entry))
+                    && fun.bm.mili.carpet.GameplayCompatRules.ownsLoaded(origin, entry)
+                    && origin.getBlockState(entry).is(Blocks.NETHER_PORTAL)
+                    && origin.isAllowedToEnterPortal(destination) && this.canPortalAsync(destination, takePassengers)) {
+                    this.beginPortalTeleport(destination, entry, takePassengers, type, teleportComplete, exit);
+                }
+            }, null, 1L));
+            try {
+                this.findPortalAsync(origin, entry, destination, type, true, lookup);
+            } catch (RuntimeException | Error failure) {
+                this.miliExistingNetherPortalLookup = false;
+                throw failure;
+            }
+            return false; // still in the origin region; an absent exit changes no entity/passenger state
+        }
+        return this.beginPortalTeleport(destination, portalPos, takePassengers, type, teleportComplete, null);
+    }
+
+    private boolean beginPortalTeleport(ServerLevel destination, BlockPos portalPos, boolean takePassengers,
