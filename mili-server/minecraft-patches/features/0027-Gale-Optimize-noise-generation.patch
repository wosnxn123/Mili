Subject: [PATCH] Gale: Optimize noise generation


diff --git a/net/minecraft/world/level/levelgen/synth/PerlinNoise.java b/net/minecraft/world/level/levelgen/synth/PerlinNoise.java
index 8e5ba8f7bed5754b6b657db30cba92fb4c7ee1b3..f320155263f69d054db14122fc37eb66a053325c 100644
--- a/net/minecraft/world/level/levelgen/synth/PerlinNoise.java
+++ b/net/minecraft/world/level/levelgen/synth/PerlinNoise.java
@@ -41,6 +41,15 @@ public class PerlinNoise extends GradientNoise implements ca.spottedleaf.moonris
         // Paper end - optimise chunk generation
     }
 
+    // Gale - C2ME - retain Mth.floor semantics for Farlands/non-finite inputs
+    protected static double luminol$floorAsDouble(final double value) {
+        if (value >= Integer.MIN_VALUE && value < Integer.MAX_VALUE) {
+            double floor = Math.floor(value);
+            return floor == 0.0 ? 0.0 : floor;
+        }
+        return Mth.floor(value);
+    }
+
     @Override
     public Interval range() {
         return RANGE;
@@ -56,12 +65,17 @@ public class PerlinNoise extends GradientNoise implements ca.spottedleaf.moonris
         double x = wrap(_x) + this.offsetX;
         double y = wrap(_y) + this.offsetY;
         double z = wrap(_z) + this.offsetZ;
-        int floorX = Mth.floor(x);
-        int floorY = Mth.floor(y);
-        int floorZ = Mth.floor(z);
-        float relativeX = (float)(x - floorX);
-        float relativeY = (float)(y - floorY);
-        float relativeZ = (float)(z - floorZ);
+        // Gale start - C2ME - keep floor values as doubles until permutation lookup
+        double floorXD = luminol$floorAsDouble(x);
+        double floorYD = luminol$floorAsDouble(y);
+        double floorZD = luminol$floorAsDouble(z);
+        int floorX = (int)floorXD;
+        int floorY = (int)floorYD;
+        int floorZ = (int)floorZD;
+        float relativeX = (float)(x - floorXD);
+        float relativeY = (float)(y - floorYD);
+        float relativeZ = (float)(z - floorZD);
+        // Gale end - C2ME - optimize noise generation
         return this.sampleAndLerp(floorX, floorY, floorZ, relativeX, relativeY, relativeZ, relativeY);
     }
 
@@ -69,12 +83,17 @@ public class PerlinNoise extends GradientNoise implements ca.spottedleaf.moonris
         double x = wrap(_x) + this.offsetX;
         double y = wrap(_y) + this.offsetY;
         double z = wrap(_z) + this.offsetZ;
-        int floorX = Mth.floor(x);
-        int floorY = Mth.floor(y);
-        int floorZ = Mth.floor(z);
-        float relativeX = (float)(x - floorX);
-        float relativeY = (float)(y - floorY);
-        float relativeZ = (float)(z - floorZ);
+        // Gale start - C2ME - keep floor values as doubles until permutation lookup
+        double floorXD = luminol$floorAsDouble(x);
+        double floorYD = luminol$floorAsDouble(y);
+        double floorZD = luminol$floorAsDouble(z);
+        int floorX = (int)floorXD;
+        int floorY = (int)floorYD;
+        int floorZ = (int)floorZD;
+        float relativeX = (float)(x - floorXD);
+        float relativeY = (float)(y - floorYD);
+        float relativeZ = (float)(z - floorZD);
+        // Gale end - C2ME - optimize noise generation
         return this.sampleWithDerivative(floorX, floorY, floorZ, relativeX, relativeY, relativeZ, derivativeOut);
     }
 
diff --git a/net/minecraft/world/level/levelgen/synth/SmearedPerlinNoise.java b/net/minecraft/world/level/levelgen/synth/SmearedPerlinNoise.java
index 64868bdc6554dea2b1b45fbdac8da6551f6ecc08..c5978cf2ae910ddbacde9871cb82b2db528b665d 100644
--- a/net/minecraft/world/level/levelgen/synth/SmearedPerlinNoise.java
+++ b/net/minecraft/world/level/levelgen/synth/SmearedPerlinNoise.java
@@ -37,12 +37,17 @@ public class SmearedPerlinNoise extends PerlinNoise {
         double x = wrap(_x) + this.offsetX;
         double y = wrap(_y) + this.offsetY;
         double z = wrap(_z) + this.offsetZ;
-        int floorX = Mth.floor(x);
-        int floorY = Mth.floor(y);
-        int floorZ = Mth.floor(z);
-        float relativeX = (float)(x - floorX);
-        double relativeY = y - floorY;
-        float relativeZ = (float)(z - floorZ);
+        // Gale start - C2ME - keep floor values as doubles until permutation lookup
+        double floorXD = luminol$floorAsDouble(x);
+        double floorYD = luminol$floorAsDouble(y);
+        double floorZD = luminol$floorAsDouble(z);
+        int floorX = (int)floorXD;
+        int floorY = (int)floorYD;
+        int floorZ = (int)floorZD;
+        float relativeX = (float)(x - floorXD);
+        double relativeY = y - floorYD;
+        float relativeZ = (float)(z - floorZD);
+        // Gale end - C2ME - optimize noise generation
         float fudgedRelativeY = (float)(relativeY - this.computeFudgeY(_y, relativeY));
         return this.sampleAndLerp(floorX, floorY, floorZ, relativeX, fudgedRelativeY, relativeZ, (float)relativeY);
     }
@@ -55,7 +60,7 @@ public class SmearedPerlinNoise extends PerlinNoise {
             fudgeLimit = relativeY;
         }
 
-        return Mth.floor(fudgeLimit / this.fudgeYScale + 1.0E-7F) * this.fudgeYScale;
+        return luminol$floorAsDouble(fudgeLimit / this.fudgeYScale + 1.0E-7F) * this.fudgeYScale; // Gale - C2ME - avoid floor int/double conversion
     }
 
     // Paper start - optimise chunk generation
