From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mrhua269 <mrhua269@gmail.com>
Date: Tue, 11 Aug 2026 20:11:46 +0800
Subject: [PATCH] Fix misbehaved ender pearls when player switched dimension

Keep Folia's dimension-change exclusion. A temporarily removed, healthy
owner is not dead while its entity scheduler can still resume it.

diff --git a/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java b/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
index 0d6739bfc20a93367944eeca3a23b381da27aebe..850df29d2466eb6d04feba703c13fe8ec44f1ddf 100644
--- a/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
+++ b/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
@@ -263,7 +263,8 @@ public class ThrownEnderpearl extends ThrowableItemProjectile {
             Entity owner = this.owner != null ? findOwnerIncludingDeadPlayer(serverLevel, this.owner.getUUID()) : null;
             if (owner instanceof ServerPlayer serverPlayer
                 && !owner.isAlive()
-                && (serverPlayer.isDeadOrDying() || serverPlayer.getRemovalReason() != Entity.RemovalReason.CHANGED_DIMENSION) // Folia - region threading - owner is temporarily removed while teleporting
+                && (serverPlayer.isDeadOrDying() || (serverPlayer.getRemovalReason() != Entity.RemovalReason.CHANGED_DIMENSION
+                    && serverPlayer.getBukkitEntity().taskScheduler.isRetired())) // Mili：不把传送中暂时移除的存活玩家当作死亡。
                 && !serverPlayer.wonGame
                 && serverPlayer.level().getGameRules().get(GameRules.ENDER_PEARLS_VANISH_ON_DEATH)) {
                 this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN); // CraftBukkit - add Bukkit remove cause
