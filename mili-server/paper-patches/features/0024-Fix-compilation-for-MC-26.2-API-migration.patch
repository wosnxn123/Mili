Subject: [PATCH] Fix compilation for MC 26.2 API migration


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index c369bbbf4162780846189851d49e21ead834a278..3b678a364c7300ae3ad76eefb606386c96676d4d 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -383,7 +383,7 @@ public final class CraftServer implements Server {
     public CraftServer(DedicatedServer console, PlayerList playerList) {
         this.console = console;
         this.playerList = (DedicatedPlayerList) playerList;
-        this.playerView = MCUtil.transformUnmodifiable(playerList.realPlayers(), ServerPlayer::getBukkitEntity); // Leaves - replay api
+        this.playerView = MCUtil.transformUnmodifiable(playerList.realPlayers, ServerPlayer::getBukkitEntity); // Leaves - replay api
         this.serverVersion = io.papermc.paper.ServerBuildInfo.buildInfo().asString(io.papermc.paper.ServerBuildInfo.StringRepresentation.VERSION_SIMPLE); // Paper - improve version
         this.structureManager = new CraftStructureManager(console.getStructureTemplateManager(), console.registryAccess());
         this.serverTickManager = new CraftServerTickManager(console.tickRateManager());
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java
index 74ca5556c72745e7c3beace93c0247c2648fe93e..18697c926d1b3e936a1e167f1d1bfa83b907b77d 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java
@@ -1165,7 +1165,7 @@ public class CraftLivingEntity extends CraftEntity implements LivingEntity {
     }
 
     private void updateWaypoint() {
-        me.earthme.luminol.utils.FoliaServerWaypointManager manager = ((ServerLevel) getHandle().level()).getWaypointManager(); // Luminol - Restore waypoints
+        me.earthme.luminol.utils.FoliaServerWaypointManager manager = (me.earthme.luminol.utils.FoliaServerWaypointManager) ((ServerLevel) getHandle().level()).getWaypointManager(); // Luminol - Restore waypoints
         manager.untrackWaypoint(getHandle());
         manager.trackWaypoint(getHandle());
     }
diff --git a/src/main/java/org/bukkit/craftbukkit/util/LazyPlayerSet.java b/src/main/java/org/bukkit/craftbukkit/util/LazyPlayerSet.java
index 9b5f976e91b193218f91ae737f08c84522ae5652..83af50de50a03e164d572f3c3466b6d0b42ed138 100644
--- a/src/main/java/org/bukkit/craftbukkit/util/LazyPlayerSet.java
+++ b/src/main/java/org/bukkit/craftbukkit/util/LazyPlayerSet.java
@@ -23,7 +23,7 @@ public class LazyPlayerSet extends LazyHashSet<Player> {
     }
 
     public static Set<Player> makePlayerSet(final MinecraftServer server) {
-        List<ServerPlayer> players = server.getPlayerList().realPlayers(); // Leaves - only real players
+        List<ServerPlayer> players = server.getPlayerList().realPlayers; // Leaves - only real players
         Set<Player> reference = new HashSet<>(players.size());
         for (ServerPlayer player : players) {
             reference.add(player.getBukkitEntity());
