+    classpath = files(compileLauncherPatch.flatMap { it.destinationDirectory }, launcherFile)
+    destinationDirectory.set(layout.buildDirectory.dir("launcher-patch/test-classes"))
+    javaCompiler.set(javaToolchains.compilerFor { languageVersion.set(JavaLanguageVersion.of(25)) })
+    options.release.set(25)
